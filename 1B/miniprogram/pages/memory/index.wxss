.detail-photo { width: 100%; height: 560rpx; border-radius: 34rpx; }
.photo-thumbs { display: flex; gap: 14rpx; margin-top: 18rpx; }
.photo-thumb { width: 90rpx; height: 90rpx; border-radius: 18rpx; overflow: hidden; border: 4rpx solid transparent; opacity: 0.6; }
.photo-thumb-image { width: 100%; height: 100%; }
.photo-thumb.is-selected { border-color: #777d64; opacity: 1; }
.detail-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; font-size: 24rpx; color: var(--muted); }
.detail-location { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--muted); margin-top: 18rpx; }
.detail-notes { font-family: var(--serif); font-size: 48rpx; line-height: 62rpx; margin: 32rpx 0; word-break: break-word; }
.detail-tags { display: flex; flex-wrap: wrap; gap: 10rpx 22rpx; font-size: 22rpx; color: #777c6c; }
.theme-dusk .detail-tags { color: #bac7ab; }
.detail-actions { display: flex; margin-top: 40rpx; padding: 28rpx 0; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.detail-action { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 22rpx; color: #878d7d; }
.detail-action.is-active { color: var(--ink); }
.detail-action-divider { border-left: 1rpx solid var(--line); }
.share-button { margin: 34rpx auto 0; padding: 0; width: auto; background: none; border: 0; line-height: 1; font-size: 24rpx; color: var(--ink); display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.share-button::after { border: none; }
.quiet-delete { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 40rpx; font-size: 22rpx; color: #99988e; }
