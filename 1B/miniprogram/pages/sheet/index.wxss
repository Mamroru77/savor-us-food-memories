.edit-avatar { position: relative; width: 196rpx; height: 196rpx; margin: 14rpx auto 10rpx; }
.edit-avatar-image { width: 196rpx; height: 196rpx; border-radius: 50%; border: 4rpx solid #ffffff; box-sizing: border-box; }
.edit-avatar-badge { position: absolute; right: -6rpx; bottom: 0; width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #eeefe7; border: 4rpx solid #ffffff; }
.sheet-couple { display: flex; align-items: center; justify-content: center; gap: 44rpx; margin-top: 20rpx; }
.couple-photo { width: 152rpx; height: 152rpx; border-radius: 50%; border: 4rpx solid #ffffff; }
.together-message { text-align: center; font-family: var(--serif); font-size: 48rpx; line-height: 60rpx; margin-top: 28rpx; }
.cuisine-label { margin-top: 36rpx; }
.cuisine-options { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.cuisine { display: flex; align-items: center; gap: 10rpx; font-size: 24rpx; padding: 16rpx 22rpx; border-radius: 22rpx; border: 1rpx solid rgba(208, 213, 196, 0.4); background: rgba(250, 251, 247, 0.4); color: #7c846e; }
.cuisine.is-selected { background: rgba(216, 222, 199, 0.5); border-color: rgba(165, 177, 142, 0.6); color: #49553a; }
.theme-dusk .cuisine { color: #bac7ab; background: rgba(170, 185, 148, 0.1); }
.theme-dusk .cuisine.is-selected { color: #dae8c7; background: rgba(156, 175, 116, 0.25); }
.preference-tip { display: flex; align-items: flex-start; gap: 18rpx; font-size: 24rpx; line-height: 38rpx; color: #818873; padding: 30rpx 0 10rpx; }
.theme-dusk .preference-tip { color: #bac7ab; }
.theme-options { display: flex; gap: 20rpx; margin: 24rpx 0 20rpx; }
.theme-option { flex: 1; padding: 16rpx; border-radius: 26rpx; border: 1rpx solid rgba(196, 204, 173, 0.4); }
.theme-option.is-selected { border-color: rgba(135, 151, 112, 0.6); background: rgba(223, 229, 208, 0.2); }
.theme-preview { height: 108rpx; border-radius: 16rpx; border: 1rpx solid rgba(255, 255, 255, 0.5); }
.theme-preview-pearl { background: radial-gradient(ellipse at 60% 0%, #fffdf8, #d5d8d5); }
.theme-preview-dusk { background: radial-gradient(ellipse at 60% 0%, #7f8175, #383f36); }
.theme-option-row { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; font-size: 26rpx; }
.app-signature { text-align: center; padding: 60rpx 0 20rpx; }
.app-signature-name { font-family: var(--serif); font-size: 84rpx; line-height: 96rpx; letter-spacing: -2rpx; }
.app-signature-text { font-size: 24rpx; color: var(--muted); margin: 6rpx 0 20rpx; }
.app-signature-small { font-size: 20rpx; color: #9ca18f; }
.privacy-intro { text-align: center; padding: 24rpx 10rpx 30rpx; display: flex; flex-direction: column; align-items: center; }
.privacy-title { font-family: var(--serif); font-size: 52rpx; line-height: 62rpx; margin-top: 26rpx; }
.privacy-text { font-size: 24rpx; line-height: 38rpx; color: var(--muted); margin-top: 16rpx; }
.weekly-sheet-stats { display: flex; justify-content: center; gap: 70rpx; margin: 14rpx 0 44rpx; }
.weekly-big { font-size: 96rpx; line-height: 104rpx; }
.weekly-muted { color: var(--muted); }
.weekly-chart { display: flex; align-items: flex-end; gap: 24rpx; height: 200rpx; margin: 0 24rpx 80rpx; }
.weekly-bar { flex: 1; height: 100%; position: relative; display: flex; flex-direction: column; justify-content: flex-end; }
.weekly-bar-fill { width: 100%; border-radius: 12rpx 12rpx 4rpx 4rpx; background: linear-gradient(rgba(195, 203, 187, 0.5), rgba(181, 191, 180, 0.3)); min-height: 14rpx; }
.weekly-bar-fill.is-highlight { background: linear-gradient(#64765a, #7f8e6b); }
.weekly-bar-label { position: absolute; bottom: -44rpx; left: 0; right: 0; text-align: center; font-size: 20rpx; color: #8e9880; }
.weekly-reflection { font-family: var(--serif); font-size: 48rpx; line-height: 58rpx; text-align: center; margin-bottom: 30rpx; }
.journey-opening { font-family: var(--serif); font-size: 64rpx; line-height: 72rpx; padding: 16rpx 0 50rpx; letter-spacing: -0.5rpx; }
.journey-timeline { margin-left: 12rpx; padding-left: 44rpx; border-left: 1rpx solid rgba(191, 200, 174, 0.5); }
.timeline-stop { position: relative; padding-bottom: 52rpx; }
.timeline-stop:last-child { padding-bottom: 0; }
.timeline-dot { position: absolute; left: -53rpx; top: 6rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #a6b693; box-shadow: 0 0 0 8rpx rgba(240, 241, 233, 0.9); }
.timeline-dot.is-current { background: #5d784f; }
.timeline-date { font-size: 21rpx; line-height: 30rpx; color: #8b9580; }
.timeline-title { font-family: var(--serif); font-size: 48rpx; line-height: 58rpx; margin: 8rpx 0; }
.timeline-text { font-size: 24rpx; line-height: 36rpx; color: var(--muted); }
.notification-row { display: flex; align-items: center; gap: 24rpx; padding: 36rpx 0; border-bottom: 1rpx solid var(--line); }
.notification-photo, .notification-symbol { width: 104rpx; height: 104rpx; border-radius: 24rpx; flex-shrink: 0; }
.notification-symbol { display: flex; align-items: center; justify-content: center; background: rgba(227, 232, 215, 0.4); }
.notification-copy { flex: 1; min-width: 0; }
.notification-title { font-size: 26rpx; line-height: 34rpx; font-weight: 500; }
.notification-text { font-size: 24rpx; line-height: 34rpx; color: var(--muted); margin-top: 6rpx; }
.notification-small { font-size: 20rpx; color: #99a086; margin-top: 8rpx; }
.caught-up { text-align: center; padding: 70rpx 0 40rpx; display: flex; flex-direction: column; align-items: center; }
.caught-up-title { font-family: var(--serif); font-size: 66rpx; line-height: 78rpx; margin-top: 30rpx; }
.caught-up-text { font-size: 24rpx; line-height: 36rpx; color: var(--muted); margin-top: 12rpx; }
.faq-item { border-bottom: 1rpx solid var(--line); }
.faq-question { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 34rpx 0; font-size: 26rpx; line-height: 36rpx; }
.faq-answer { font-size: 24rpx; line-height: 38rpx; color: var(--muted); padding-bottom: 34rpx; }
.feedback-textarea { height: 200rpx; }
