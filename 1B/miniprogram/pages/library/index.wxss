.library-tabs { display: flex; gap: 8rpx; padding: 6rpx; border-radius: 26rpx; background: rgba(220, 224, 212, 0.35); margin-top: 10rpx; }
.library-tab { flex: 1; text-align: center; font-size: 24rpx; padding: 16rpx 6rpx; border-radius: 20rpx; color: var(--muted); }
.library-tab.is-active { background: rgba(255, 255, 255, 0.75); color: var(--ink); box-shadow: 0 2rpx 10rpx rgba(101, 111, 75, 0.08); }
.theme-dusk .library-tab.is-active { background: rgba(170, 185, 148, 0.2); }
.sheet-search { height: 82rpx; border: 1rpx solid rgba(255, 255, 255, 0.6); background: rgba(255, 255, 255, 0.4); padding: 0 22rpx; border-radius: 24rpx; display: flex; align-items: center; gap: 14rpx; margin-top: 28rpx; }
.theme-dusk .sheet-search { background: rgba(170, 185, 148, 0.14); border-color: rgba(203, 215, 184, 0.2); }
.sheet-search-input { flex: 1; min-width: 0; font-size: 25rpx; color: var(--ink); }
.library-count { font-size: 22rpx; color: #858b7c; margin: 26rpx 4rpx 12rpx; }
.theme-dusk .library-count { color: #bac7ab; }
.backup-actions { display: flex; gap: 16rpx; margin-top: 36rpx; }
.backup-export { flex: 1; }
.local-note { margin-top: 28rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; font-size: 21rpx; color: #989b8e; }
