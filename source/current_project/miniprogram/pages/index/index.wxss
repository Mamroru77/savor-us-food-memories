page {
  background: #fff9f3;
  color: #3f302b;
}

.page {
  padding: 36rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 34rpx;
}

.hello {
  font-size: 27rpx;
  color: #806f67;
  margin-bottom: 12rpx;
}

.headline {
  font-size: 38rpx;
  font-weight: 600;
}

.number {
  color: #ff755e;
  font-size: 54rpx;
  margin: 0 8rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  background: #ffe8d5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
}

.memory-card {
  background: #fff;
  border-radius: 34rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(97, 68, 52, .08);
}

.cover {
  height: 310rpx;
  background: linear-gradient(135deg, #5a3828, #b56c45);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.food-icon {
  font-size: 120rpx;
}

.cover-label {
  position: absolute;
  left: 26rpx;
  bottom: 24rpx;
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
}

.memory-info {
  padding: 28rpx;
}

.memory-title {
  font-size: 31rpx;
  font-weight: 600;
}

.memory-desc {
  margin-top: 10rpx;
  color: #927f76;
  font-size: 24rpx;
  line-height: 1.7;
}

.section-title {
  display: flex;
  justify-content: space-between;
  margin: 44rpx 4rpx 20rpx;
  font-size: 31rpx;
  font-weight: 600;
}

.more {
  color: #a6948a;
  font-size: 24rpx;
  font-weight: 400;
}

.map-card {
  height: 250rpx;
  background: #f4eadf;
  border-radius: 30rpx;
  position: relative;
  overflow: hidden;
}

.map-road {
  position: absolute;
  height: 18rpx;
  background: rgba(255,255,255,.8);
  border-radius: 20rpx;
}

.road-a {
  width: 650rpx;
  top: 70rpx;
  left: -80rpx;
  transform: rotate(-14deg);
}

.road-b {
  width: 600rpx;
  top: 160rpx;
  left: 70rpx;
  transform: rotate(18deg);
}

.pin {
  position: absolute;
  width: 52rpx;
  height: 52rpx;
  background: #ff7b65;
  border-radius: 50%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pin-a {
  left: 110rpx;
  top: 55rpx;
}

.pin-b {
  right: 115rpx;
  top: 80rpx;
}

.map-text {
  position: absolute;
  bottom: 18rpx;
  width: 100%;
  text-align: center;
  color: #806d64;
  font-size: 22rpx;
  line-height: 1.5;
}

.stats {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.stat {
  flex: 1;
  padding: 24rpx 0;
  background: white;
  border-radius: 26rpx;
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #ff755e;
}

.stat-label {
  display: block;
  margin-top: 5rpx;
  color: #928078;
  font-size: 22rpx;
}

.empty-card {
  background: white;
  border-radius: 32rpx;
  padding: 50rpx 30rpx;
  text-align: center;
}

.empty-icon {
  font-size: 66rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 15rpx;
}

.empty-desc {
  color: #99867d;
  font-size: 24rpx;
  margin: 12rpx 0 28rpx;
}

.main-button {
  width: 330rpx;
  border: none;
  border-radius: 50rpx;
  color: white;
  font-size: 27rpx;
  background: linear-gradient(135deg, #ff9274, #ff705f);
}

.main-button::after {
  border: none;
}

.bottom-placeholder {
  height: 160rpx;
}

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 118rpx;
  background: rgba(255,255,255,.97);
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -5rpx 30rpx rgba(70,50,40,.06);
}

.tab {
  width: 110rpx;
  text-align: center;
  color: #917f77;
  font-size: 20rpx;
}

.tab-icon {
  font-size: 35rpx;
  margin-bottom: 3rpx;
}

.active {
  color: #ff755e;
}

.plus {
  width: 86rpx;
  height: 86rpx;
  margin-top: -38rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9475, #ff705f);
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 53rpx;
  box-shadow: 0 10rpx 25rpx rgba(255,112,95,.3);
}
.cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(40, 25, 18, 0) 45%, rgba(40, 25, 18, .5) 100%);
  pointer-events: none;
}

.memory-meta {
  margin-top: 9rpx;
  color: #b06f56;
  font-size: 23rpx;
}

.memory-scroll {
  width: 100%;
  white-space: nowrap;
}

.memory-row {
  display: inline-flex;
  gap: 18rpx;
  padding: 2rpx 4rpx 12rpx;
}

.mini-memory {
  width: 235rpx;
  display: inline-block;
  vertical-align: top;
}

.mini-cover {
  width: 235rpx;
  height: 210rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f5e8df;
}

.mini-cover image {
  width: 100%;
  height: 100%;
}

.mini-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 66rpx;
}

.mini-title {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-meta {
  margin-top: 5rpx;
  color: #9c887f;
  font-size: 21rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
