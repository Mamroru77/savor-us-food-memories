/* Bundled web fonts, embedded as base64 TTF so the DevTools simulator
   applies them via plain CSS. wx.loadFontFace (utils/fonts.js) covers the
   native layer. Serif alias "SavorSerif" = Lora (concept-matching rounded
   serif; swap the alias here if the display face ever changes). */
@font-face { font-family: 'DMSans'; font-style: normal; font-weight: 400; src: url(data:font/truetype;base64,) format('truetype'); }
@font-face { font-family: 'DMSans'; font-style: normal; font-weight: 500; src: url(data:font/truetype;base64,) format('truetype'); }
@font-face { font-family: 'DMSans'; font-style: normal; font-weight: 700; src: url(data:font/truetype;base64,) format('truetype'); }
@font-face { font-family: 'SavorSerif'; font-style: normal; font-weight: 400; src: url(data:font/truetype;base64,) format('truetype'); }
@font-face { font-family: 'SavorSerif'; font-style: normal; font-weight: 500; src: url(data:font/truetype;base64,) format('truetype'); }

page {
  /* palette */
  --ink: #1b1c1a;
  --muted: #565752;
  --glass: rgba(252, 251, 249, 0.45);
  --glass-border: rgba(255, 255, 255, 0.7);
  --field: rgba(255, 255, 255, 0.48);
  --serif: 'SavorSerif', Georgia, 'Times New Roman', 'Songti SC', 'STSong', 'SimSun', serif;
  --sans: 'DMSans', -apple-system, 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;

  /* tab bar system tokens (tab bar + bottom spacers share these) */
  --tabbar-height: 170rpx;
  --tabbar-gap: 26rpx;
  /* total clearance pages must reserve under scrolling content */
  --tab-clearance: calc(var(--tabbar-height) + var(--tabbar-gap) + env(safe-area-inset-bottom));

  font-family: var(--sans);
  color: var(--ink);
  font-size: 26rpx;
  line-height: 38rpx;
}

/* ---------- shared page scaffolding ---------- */
/* Pages scroll with the page itself (most reliable on real devices);
   the map screen re-enables its own fixed viewport via .map-screen. */
.screen {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background:
    radial-gradient(ellipse 43% 44% at 52% 9%, rgba(251, 247, 240, 0.94), transparent 82%),
    radial-gradient(ellipse 27% 54% at 17% 51%, rgba(228, 229, 229, 0.78), transparent 90%),
    radial-gradient(ellipse 24% 68% at 75% 65%, rgba(242, 236, 228, 0.54), transparent 90%),
    linear-gradient(143deg, #f0f0ef 0%, #eeece9 42%, #e7e6e3 100%);
}

.screen-wallpaper {
  /* fixed: stays a stable blurred backdrop while the page scrolls */
  position: fixed;
  top: -160rpx;
  left: -100rpx;
  right: -100rpx;
  bottom: -160rpx;
  z-index: 0;
  opacity: 0.17;
  /* rpx is unreliable inside filter on some devices — px here on purpose.
     Warmer + softer so glass cards melt visible color, not flat gray. */
  filter: blur(60px) grayscale(0.7);
  pointer-events: none;
}

.screen-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
}

/* Dynamic ambient light: the featured photo (Home: weekly photo, Add:
   current draft photo, Us/Me: page artwork) blurred into a soft field.
   Fitted against the concept mockup by pixel-sampling: LOW opacity +
   LOW blur keeps the silhouette faintly readable; the translate places
   the subject's dark mass behind the hero card like the mockup. */
.ambient-photo {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  opacity: 0.22;
  filter: blur(10px) saturate(1.08);
  transform: translate(-9.6%, 5.5%) scale(1.35);
  pointer-events: none;
}
.quiet .ambient-photo { transition: none !important; animation: none !important; }

/* every tab page ends its scroll content with this spacer so the
   floating tab bar never covers content (token-driven, no guessing) */
.tab-spacer {
  width: 100%;
  height: calc(var(--tab-clearance) + 24rpx);
}

/* ---------- typography helpers ---------- */
.serif { font-family: var(--serif); font-weight: 400; }

.screen-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.screen-heading .heading-title {
  font-family: var(--serif);
  font-size: 52rpx;
  line-height: 62rpx;
  letter-spacing: -0.5rpx;
}
.screen-heading .heading-sub {
  margin-top: 5rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--muted);
}

/* ---------- primitives ---------- */
.glass {
  background: var(--glass);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  /* web base shadow + a wide ambient halo so cards sit in soft light
     the way the concept mockup renders them */
  box-shadow:
    0 30rpx 60rpx -30rpx rgba(64, 65, 65, 0.2),
    0 12rpx 36rpx -10rpx rgba(84, 84, 88, 0.09),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.24);
  -webkit-backdrop-filter: blur(42rpx);
  backdrop-filter: blur(42rpx);
}

.stat { display: flex; flex-direction: column; font-size: 25rpx; line-height: 35rpx; }
.stat-strong { font-family: var(--serif); font-weight: 400; letter-spacing: -1rpx; }

.primary-button {
  min-height: 98rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 60rpx;
  background: linear-gradient(150deg, #31322f, #181a17);
  color: #fff;
  font-size: 29rpx;
  font-weight: 450;
  box-shadow: 0 8rpx 18rpx -8rpx rgba(17, 17, 17, 0.33), inset 0 0 0 2rpx #10120f;
  padding: 22rpx 35rpx;
  box-sizing: border-box;
}
.primary-button.ghosted { opacity: 0.6; }

.secondary-button {
  min-height: 85rpx;
  border-radius: 27rpx;
  border: 1rpx solid rgba(212, 215, 202, 0.44);
  background: rgba(229, 231, 221, 0.36);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  padding: 17rpx 27rpx;
  font-size: 25rpx;
  box-sizing: border-box;
}

.form-error {
  margin: 22rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  line-height: 38rpx;
  color: #994d3d;
  background: rgba(245, 218, 208, 0.5);
}

.empty-state {
  width: 100%;
  padding: 62rpx 20rpx;
  font-size: 27rpx;
  line-height: 45rpx;
  text-align: center;
  color: var(--muted);
}
.empty-state .empty-action { display: inline-block; margin-top: 22rpx; text-decoration: underline; text-underline-offset: 8rpx; }

.helper-note { font-size: 24rpx; line-height: 38rpx; color: #858979; }

/* ---------- form fields ---------- */
.form-field { display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.form-label { font-size: 25rpx; line-height: 32rpx; font-weight: 600; }
.form-input,
.form-textarea {
  width: 100%;
  min-height: 82rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  background: var(--field);
  border-radius: 27rpx;
  padding: 17rpx 22rpx;
  font-size: 27rpx;
  line-height: 40rpx;
  box-sizing: border-box;
  color: var(--ink);
}
.form-placeholder { color: #93938d; }

/* ---------- toggle ---------- */
.toggle-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-align: left;
  gap: 38rpx;
  padding: 35rpx 0;
  border-bottom: 1rpx solid rgba(144, 156, 120, 0.13);
}
.toggle-copy { display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.toggle-copy-strong { font-size: 27rpx; line-height: 38rpx; font-weight: 500; }
.toggle-copy-small { font-size: 22rpx; line-height: 35rpx; color: var(--muted); }
.toggle-track {
  height: 52rpx;
  width: 88rpx;
  flex-shrink: 0;
  background: #c5cbbd;
  padding: 8rpx;
  border-radius: 38rpx;
  transition: background 0.2s;
  box-sizing: border-box;
}
.toggle-knob {
  display: block;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(62, 78, 37, 0.11);
  transition: transform 0.2s;
}
.toggle-track.on { background: #68765b; }
.toggle-track.on .toggle-knob { transform: translateX(36rpx); }

/* ---------- toast ---------- */
.savor-toast {
  position: fixed;
  z-index: 500;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(var(--tab-clearance) + 16rpx);
  max-width: calc(100vw - 64rpx);
  display: flex;
  align-items: center;
  gap: 27rpx;
  padding: 32rpx 32rpx 32rpx 40rpx;
  background: rgba(37, 41, 33, 0.96);
  color: #fcfcf7;
  border: 1rpx solid rgba(243, 244, 232, 0.14);
  border-radius: 38rpx;
  box-shadow: 0 20rpx 60rpx rgba(34, 42, 28, 0.15);
  font-size: 28rpx;
  line-height: 45rpx;
}
.savor-toast-text { flex: 1; }

/* ---------- quiet motion (reduceMotion setting) ---------- */
.quiet .anim,
.quiet .screen-wallpaper { transition: none !important; animation: none !important; }

@keyframes savor-spin { to { transform: rotate(360deg); } }
.spin { animation: savor-spin 0.9s linear infinite; }

/* ---------- dusk theme ---------- */
.dusk {
  --ink: #edece5;
  --muted: #bfc3b7;
  --glass: rgba(66, 72, 62, 0.46);
  --glass-border: rgba(225, 229, 214, 0.19);
  --field: rgba(222, 228, 210, 0.085);
  color: var(--ink);
  background: radial-gradient(ellipse at 50% 0%, #989b8c, transparent 75%), linear-gradient(130deg, #575e56, #697267);
}
