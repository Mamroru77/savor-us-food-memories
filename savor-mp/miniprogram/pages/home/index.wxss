/* Home — port of screens.css “Home” (×2.5). */
.home-screen {
  padding-left: 35rpx;
  padding-right: 35rpx;
  padding-bottom: calc(var(--tab-clearance) + 20rpx);
}

.notification-button {
  position: absolute;
  right: 42rpx;
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  z-index: 5;
}
.notification-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e36c5b;
  box-shadow: 0 0 0 2rpx #f6f2ee;
}

.home-intro { padding: 96rpx 30rpx 0; display: flex; flex-direction: column; }
.home-intro-title {
  display: flex;
  flex-direction: column;
  font-family: var(--serif);
  font-size: 82rpx;
  line-height: 80rpx;
  letter-spacing: -1.1rpx;
}
.home-intro-sub {
  margin-top: 30rpx;
  font-size: 27rpx;
  line-height: 44rpx;
  color: #565752;
  max-width: 400rpx;
}
.dusk .home-intro-sub { color: #bfc3b7; }

.weekly-card {
  position: relative;
  width: 100%;
  height: 352rpx;
  padding: 40rpx;
  margin-top: 62rpx;
  border-radius: 45rpx;
  box-sizing: border-box;
  /* more translucent than base glass so the ambient glow reads
     through the surface, exactly like the concept card */
  background: rgba(255, 254, 252, 0.36);
  box-shadow: 0 38rpx 62rpx -25rpx rgba(64, 65, 65, 0.3), inset 0 2rpx 0 rgba(255, 255, 255, 0.4);
  overflow: hidden;
}
.weekly-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.weekly-heading-text {
  font-family: var(--serif);
  font-size: 34rpx;
  line-height: 40rpx;
}
.weekly-stats {
  position: absolute;
  left: 45rpx;
  top: 137rpx;
  display: flex;
  gap: 60rpx;
}
.weekly-stat { font-size: 27rpx; gap: 5rpx; }
.weekly-strong { font-size: 85rpx; line-height: 88rpx; }
.weekly-stat-divided { border-left: 1rpx solid rgba(84, 85, 84, 0.055); padding-left: 52rpx; }
.weekly-photo {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  width: 215rpx;
  height: 215rpx;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 22rpx -15rpx #34312a;
  background: rgba(255, 255, 255, 0.4);
}

.recent-section { margin-top: 58rpx; }
.recent-title {
  display: block;
  margin: 0 27rpx 20rpx;
  font-family: var(--serif);
  font-size: 32rpx;
  line-height: 40rpx;
}
.recent-list { border-radius: 42rpx; padding: 0 30rpx;  background: rgba(255, 254, 252, 0.4); }
