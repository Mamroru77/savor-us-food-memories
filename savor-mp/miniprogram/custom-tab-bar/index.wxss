
/* Font tokens on :host — the single source of truth lives in app.wxss;
   this fallback keeps type consistent even if variable inheritance is
   interrupted by the component boundary. */
:host {
  --serif: 'SavorSerif', Georgia, 'Times New Roman', 'Songti SC', 'STSong', 'SimSun', serif;
  --sans: 'DMSans', -apple-system, 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;
  font-family: var(--sans);
}
/* Floating glass tab bar — tokens mirror app.wxss
   (--tabbar-height: 170rpx, --tabbar-gap: 26rpx).
   Motion parity with the web BottomNav:
   - nav-item: color transition + icon lift on active (web hover lift)
   - add-nav-button: whileTap scale .91 + slight lift                     */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  height: calc(170rpx + env(safe-area-inset-bottom));
  padding: 6rpx 20rpx calc(26rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(rgba(249, 248, 246, 0.66), rgba(246, 246, 244, 0.84));
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(55rpx);
  -webkit-backdrop-filter: blur(55rpx);
}
.theme-dusk.tab-bar {
  background: linear-gradient(rgba(77, 89, 75, 0.91), rgba(70, 80, 67, 0.93));
  border-top-color: rgba(202, 211, 189, 0.13);
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 24rpx;
  line-height: 30rpx;
  color: #828480;
  transition: color 0.2s, opacity 0.15s, transform 0.15s;
}
.tab-item.is-active { color: #171a16; font-weight: 600; }
.theme-dusk .tab-item { color: #a3af98; }
.theme-dusk .tab-item.is-active { color: #f0f4e9; }

.tab-label { transition: color 0.2s; }

/* icon wrapper: active lift (web :hover svg translateY(-2px)) + pop on select */
.tab-icon-wrap {
  display: flex;
  transition: transform 0.22s ease;
}
.tab-item.is-active .tab-icon-wrap {
  transform: translateY(-2rpx);
  animation: tab-pop 0.38s cubic-bezier(0.2, 0.7, 0.3, 1.35);
}
@keyframes tab-pop {
  0%   { transform: scale(0.72) translateY(0); }
  55%  { transform: scale(1.16) translateY(-5rpx); }
  100% { transform: scale(1) translateY(-2rpx); }
}

/* press feedback (hover-class on the tab item) */
.tab-press { opacity: 0.7; }
.tab-press .tab-icon-wrap { transform: scale(0.88); }

.tab-add {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-add-button {
  width: 130rpx;
  height: 130rpx;
  margin-top: -14rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.97), rgba(217, 217, 215, 0.83));
  box-shadow: 0 18rpx 28rpx -5rpx rgba(59, 62, 61, 0.21), 0 0 0 18rpx rgba(248, 248, 246, 0.27), inset 0 2rpx 5rpx #ffffff;
  box-sizing: border-box;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
/* web: whileTap={{scale:.91}} + whileHover={{y:-2}} */
.add-press {
  transform: scale(0.9) translateY(-4rpx);
  box-shadow: 0 10rpx 18rpx -6rpx rgba(59, 62, 61, 0.24), 0 0 0 14rpx rgba(248, 248, 246, 0.32), inset 0 2rpx 5rpx #ffffff;
}
.theme-dusk .tab-add-button {
  box-shadow: 0 18rpx 28rpx -5rpx rgba(20, 24, 18, 0.4), 0 0 0 18rpx rgba(90, 100, 84, 0.35), inset 0 2rpx 5rpx rgba(255, 255, 255, 0.7);
}

/* Quiet motion (reduceMotion setting) removes every tab animation */
.theme-quiet .tab-item,
.theme-quiet .tab-icon-wrap,
.theme-quiet .tab-add-button,
.theme-quiet .tab-label { transition: none !important; animation: none !important; }
.theme-quiet .tab-item.is-active .tab-icon-wrap { animation: none !important; transform: none; }
