.add-body { padding: 0 44rpx; }
.photo-row { display: flex; align-items: center; gap: 20rpx; margin-top: 40rpx; }
.main-photo { position: relative; width: 445rpx; height: 430rpx; border-radius: 42rpx; overflow: hidden; flex-shrink: 0; }
.main-photo-image { width: 100%; height: 100%; }
.photo-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; border: 2rpx dashed rgba(255, 255, 255, 0.9); border-radius: 42rpx; box-sizing: border-box; background: rgba(255, 255, 255, 0.18); color: var(--muted); font-size: 24rpx; }
.edit-photo { position: absolute; right: 22rpx; top: 22rpx; height: 58rpx; padding: 0 20rpx; display: flex; align-items: center; gap: 8rpx; border-radius: 40rpx; border: 1rpx solid rgba(255, 255, 255, 0.72); background: rgba(249, 248, 245, 0.84); font-size: 23rpx; color: #33332f; }
.photo-busy { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; background: rgba(247, 245, 240, 0.7); font-size: 24rpx; color: #565752; }
.more-photos { position: relative; flex: 1; }
.add-photo { position: relative; height: 320rpx; border: 3rpx dashed rgba(255, 255, 255, 0.93); border-radius: 40rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; background: rgba(255, 255, 255, 0.14); }
.add-photo-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.65; }
.add-photo-copy { position: relative; display: flex; flex-direction: column; align-items: center; gap: 14rpx; font-size: 24rpx; color: var(--muted); }
.has-photo .add-photo-copy { color: #ffffff; text-shadow: 0 1rpx 6rpx #555555; }
.remove-extra { position: absolute; top: -12rpx; right: -10rpx; width: 48rpx; height: 48rpx; border-radius: 50%; background: #f4f2ed; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15); }
.input-wrap { position: relative; }
.input-wrap .field-input { padding-right: 76rpx; }
.input-clear { position: absolute; right: 8rpx; top: 11rpx; }
.new-place { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; font-size: 22rpx; color: var(--muted); }
.date-rating { display: flex; gap: 32rpx; }
.date-rating .form-field { flex: 1; min-width: 0; }
.rating-input { height: 82rpx; border: 1rpx solid rgba(255, 255, 255, 0.75); border-radius: 26rpx; background: var(--field); display: flex; align-items: center; justify-content: space-around; padding: 0 8rpx; }
.theme-dusk .rating-input { border-color: rgba(206, 217, 189, 0.2); }
.rating-star { width: 52rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; min-height: 58rpx; }
.add-tag { width: 58rpx; height: 58rpx; background: rgba(212, 212, 208, 0.55); }
.tag-popover { margin-top: 16rpx; padding: 22rpx; border-radius: 32rpx; background: rgba(248, 247, 243, 0.97); border: 1rpx solid var(--glass-border); }
.theme-dusk .tag-popover { background: rgba(66, 77, 62, 0.97); }
.tag-input-row { display: flex; align-items: center; gap: 12rpx; }
.tag-input { flex: 1; min-height: 72rpx; line-height: 72rpx; }
.suggested-tags { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 20rpx; }
.suggested-tag { font-size: 24rpx; color: #62665b; text-decoration: underline; }
.theme-dusk .suggested-tag { color: #c5d1b4; }
.save-memory { margin-top: 40rpx; height: 100rpx; }
