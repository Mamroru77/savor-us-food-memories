.map-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
.map-stage { position: relative; flex: 1; min-height: 0; }
.memory-map { width: 100%; height: 100%; }
.map-fade { position: absolute; left: 0; right: 0; top: 0; height: 200rpx; pointer-events: none; background: linear-gradient(rgba(238, 237, 235, 0.95), rgba(238, 237, 235, 0)); }
.theme-dusk .map-fade { background: linear-gradient(rgba(72, 81, 65, 0.95), rgba(72, 81, 65, 0)); }
.map-failed { position: absolute; top: 150rpx; left: 42rpx; right: 42rpx; z-index: 3; text-align: center; font-size: 23rpx; color: var(--muted); }
.map-search {
  position: absolute; top: 24rpx; left: 42rpx; right: 42rpx; height: 96rpx; z-index: 6; border-radius: 38rpx; display: flex; align-items: center; gap: 14rpx;
  padding: 0 14rpx 0 30rpx; background: rgba(255, 255, 255, 0.86); box-shadow: 0 18rpx 32rpx -20rpx rgba(66, 67, 63, 0.4);
}
.theme-dusk .map-search { background: rgba(70, 82, 63, 0.94); }
.map-search-input { flex: 1; min-width: 0; height: 100%; font-size: 25rpx; color: var(--ink); }
.map-placeholder { color: #7b7e78; }
.theme-dusk .map-placeholder { color: #c9d1c0; }
.map-icon-button { width: 56rpx; height: 56rpx; }
.filter-active { background: #d5dccf; }
.theme-dusk .filter-active { background: rgba(213, 220, 207, 0.3); }
.recenter { position: absolute; z-index: 5; top: 150rpx; right: 42rpx; width: 88rpx; height: 88rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.9); box-shadow: 0 10rpx 20rpx rgba(85, 85, 85, 0.15); }
.theme-dusk .recenter { background: rgba(72, 83, 64, 0.95); }
.map-menu { position: absolute; z-index: 8; top: 140rpx; left: 42rpx; right: 42rpx; border-radius: 38rpx; background: rgba(248, 248, 244, 0.97); padding: 24rpx 30rpx; box-shadow: 0 20rpx 48rpx rgba(67, 73, 60, 0.2); }
.theme-dusk .map-menu { background: rgba(70, 82, 63, 0.97); }
.map-menu-title { font-size: 22rpx; color: var(--muted); margin-bottom: 8rpx; }
.map-menu-item { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 4rpx; font-size: 27rpx; border-bottom: 1rpx solid var(--line); }
.map-menu-item:last-child { border-bottom: 0; }
.map-count { position: absolute; z-index: 3; top: 150rpx; left: 52rpx; font-size: 22rpx; padding: 8rpx 14rpx; border-radius: 10rpx; background: rgba(247, 247, 241, 0.85); color: #656d5d; }
.pin { width: 44px; height: 44px; border-radius: 22px; background: #fafaf7; padding: 3px; box-sizing: border-box; }
.pin-selected { background: #e2e6da; }
.pin-photo { width: 38px; height: 38px; border-radius: 19px; }
.place-card {
  position: absolute; left: 32rpx; right: 32rpx; bottom: calc(190rpx + env(safe-area-inset-bottom)); height: 316rpx; z-index: 5; border-radius: 45rpx;
  background: rgba(251, 250, 247, 0.9); box-shadow: 0 20rpx 48rpx -18rpx rgba(68, 71, 63, 0.4);
}
.theme-dusk .place-card { background: rgba(70, 82, 63, 0.94); }
.place-open { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; height: 100%; padding: 30rpx 30rpx 30rpx 40rpx; box-sizing: border-box; }
.place-copy { flex: 1; min-width: 0; }
.place-name { font-family: var(--serif); font-size: 50rpx; line-height: 60rpx; letter-spacing: -1rpx; margin-bottom: 10rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.place-line { font-size: 24rpx; line-height: 40rpx; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.place-date { margin-top: 30rpx; font-size: 25rpx; color: var(--muted); }
.place-photo { width: 212rpx; height: 246rpx; border-radius: 30rpx; flex-shrink: 0; border: 2rpx solid rgba(255, 255, 255, 0.8); }
.bookmark-place { position: absolute; right: 262rpx; bottom: 30rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.map-empty { position: absolute; z-index: 4; left: 50rpx; right: 50rpx; bottom: calc(220rpx + env(safe-area-inset-bottom)); border-radius: 45rpx; padding: 56rpx 36rpx; display: flex; flex-direction: column; align-items: center; text-align: center; background: rgba(248, 247, 241, 0.95); }
.theme-dusk .map-empty { background: rgba(70, 82, 63, 0.96); }
.map-empty-title { font-family: var(--serif); font-size: 56rpx; line-height: 66rpx; margin-top: 24rpx; }
.map-empty-text { margin: 14rpx 0 34rpx; font-size: 25rpx; color: var(--muted); }
.map-empty-link { font-size: 27rpx; text-decoration: underline; }
