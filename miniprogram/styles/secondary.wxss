/* Secondary pages share the existing pearl / Nocturne materials.
   Scope all rules here: native maps, the five tabs and primary-page layouts are untouched. */
.secondary-screen {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--space-lg) var(--page-gutter) calc(48rpx + env(safe-area-inset-bottom));
  font-family: var(--sans);
  color: var(--ink);
  font-size: 27rpx;
  line-height: 40rpx;
}
.secondary-screen .eyebrow { display:block; color:var(--muted); font-size:22rpx; line-height:32rpx; letter-spacing:2rpx; margin-bottom:12rpx; }
.secondary-screen .title { display:block; font-family:var(--serif); font-size:48rpx; line-height:64rpx; font-weight:400; margin:0 0 16rpx; overflow-wrap:break-word; }
.secondary-screen.locale-zh .title { font-family:var(--sans); font-size:var(--type-page-zh); line-height:var(--leading-page); letter-spacing:.6rpx; }
.secondary-screen .heading { display:block; font-size:30rpx; line-height:42rpx; font-weight:500; margin:0; overflow-wrap:break-word; }
.secondary-screen .hint { display:block; font-size:24rpx; line-height:38rpx; color:var(--muted); overflow-wrap:break-word; }
.secondary-screen .card {
  display:flex; flex-direction:column; gap:20rpx;
  padding:var(--card-inset); margin:var(--space-md) 0 0; border-radius:var(--radius-card);
  border:1rpx solid var(--content-card-border, var(--glass-border));
  background:var(--content-card-bg, var(--glass));
  box-shadow:var(--content-card-shadow);
  -webkit-backdrop-filter:blur(var(--content-card-blur,20px));
  backdrop-filter:blur(var(--content-card-blur,20px));
}
.secondary-screen button {
  display:flex; align-items:center; justify-content:center; gap:12rpx;
  width:100%; min-height:var(--control-height,88rpx); box-sizing:border-box;
  padding:18rpx 24rpx; margin:20rpx 0 0;
  border:1rpx solid rgba(112,121,101,.20); border-radius:var(--control-radius,27rpx);
  background:rgba(229,231,221,.46); color:var(--ink);
  font-family:var(--sans); font-size:27rpx; line-height:40rpx; font-weight:400;
  white-space:normal; overflow-wrap:break-word;
}
.secondary-screen button::after { border:0; }
.secondary-screen .card > button { margin-top:0; }
.secondary-screen .ui-primary { min-height:98rpx; background:linear-gradient(150deg,#31322f,#181a17); color:#fff; border:2rpx solid rgba(255,255,255,.8); border-radius:60rpx; font-weight:500; box-shadow:0 8rpx 18rpx -8rpx rgba(17,17,17,.25); }
.secondary-screen .ui-danger { color:#994d3d; background:rgba(245,218,208,.24); border-color:rgba(153,77,61,.22); }
.secondary-screen .ui-disabled { opacity:.78; box-shadow:none; color:var(--muted) !important; }
.secondary-screen .ui-primary.ui-disabled { color:#fff !important; background:linear-gradient(150deg,#31322f,#181a17) !important; }
.secondary-screen.dusk .ui-primary.ui-disabled { color:#f5f0e8 !important; background:linear-gradient(145deg,#5a4d3d,#483e32) !important; }
.secondary-screen.dusk button { background:#2b2c30; color:var(--ink); border-color:var(--glass-border); }
.secondary-screen.dusk .ui-primary { background:linear-gradient(145deg,#5a4d3d,#483e32); color:#f5f0e8; border-color:rgba(222,200,167,.28); }
.secondary-screen.dusk .ui-danger { color:#ffc0aa; background:rgba(140,57,43,.18); border-color:rgba(255,192,170,.2); }
.secondary-screen input, .secondary-screen textarea, .secondary-screen .field {
  display:block; width:100%; min-height:var(--control-height,88rpx); height:auto;
  box-sizing:border-box; padding:22rpx; margin:0;
  border:1rpx solid var(--glass-border); border-radius:var(--control-radius,27rpx);
  background:var(--field); color:var(--ink); font-family:var(--sans);
  font-size:var(--field-font-size,27rpx); line-height:var(--field-line-height,40rpx);
}
.secondary-screen textarea { height:220rpx; }
.secondary-screen > picker, .secondary-screen > view > picker { display:block; margin-top:24rpx; }
.secondary-screen .secondary-placeholder { color:var(--muted); }
.secondary-screen .field { display:flex; align-items:center; }
.secondary-screen .actions { display:flex; flex-wrap:wrap; gap:12rpx; }
.secondary-screen .actions button { flex:1 1 140rpx; width:auto; margin:0; padding:14rpx 18rpx; font-size:25rpx; }
.secondary-screen .row { padding:20rpx 0; border-bottom:1rpx solid var(--glass-border); font-size:25rpx; line-height:38rpx; overflow-wrap:anywhere; }
.secondary-screen .row:last-child { border-bottom:0; }
.secondary-screen .row text { display:block; }
.secondary-screen .technical { font-size:22rpx; line-height:34rpx; color:var(--muted); overflow-wrap:anywhere; }
.secondary-screen .notice { display:block; padding:20rpx 22rpx; margin:24rpx 0 0; border-radius:20rpx; background:rgba(112,121,101,.08); border:1rpx solid var(--glass-border); font-size:24rpx; line-height:38rpx; color:var(--muted); overflow-wrap:anywhere; }
.secondary-screen .card .notice { margin:0; }
.secondary-screen .ui-empty { padding:28rpx 12rpx; text-align:center; font-size:25rpx; line-height:40rpx; color:var(--muted); }
.secondary-screen .switch-row { display:flex; align-items:center; gap:20rpx; padding:20rpx 0; }
.secondary-screen .switch-row switch { flex-shrink:0; }
.secondary-screen .switch-row text { flex:1; min-width:0; font-size:25rpx; line-height:38rpx; }
