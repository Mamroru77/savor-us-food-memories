
/* Font tokens on :host — the single source of truth lives in app.wxss;
   this fallback keeps type consistent even if variable inheritance is
   interrupted by the component boundary. */
:host {
  --serif: 'SavorSerif', Georgia, 'PingFang SC', 'Noto Sans CJK SC', 'Microsoft YaHei', sans-serif;
  --sans: 'DMSans', -apple-system, 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;
  font-family: var(--sans);
}
.toast-dismiss {
  padding: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.savor-toast { animation:toast-enter 220ms ease both; }
.savor-toast.toast-leaving { pointer-events:none;animation:toast-exit 220ms ease both; }
@keyframes toast-enter { from {opacity:0;transform:translate(-50%,18rpx);} to {opacity:1;transform:translate(-50%,0);} }
@keyframes toast-exit { from {opacity:1;transform:translate(-50%,0);} to {opacity:0;transform:translate(-50%,18rpx);} }
.savor-toast.quiet { animation:none; }

.toast-dismiss { min-width:88rpx; min-height:88rpx; box-sizing:border-box; padding:6rpx; }
.savor-toast-text { min-width:0; overflow-wrap:break-word; }

/* Hit area uses existing padding instead of increasing Toast visual height. */
.toast-dismiss { margin:-19rpx; }
