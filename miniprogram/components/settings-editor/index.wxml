<view class="settings-editor {{dusk ? 'is-dusk' : ''}}">
  <block wx:if="{{type === 'preferences'}}">
    <view class="settings-form">
      <view class="form-field">
        <text class="form-label">{{copy.sb5923d1970}}</text>
        <picker range="{{dietaryOptions}}" value="{{dietaryIndex}}" bindchange="onDietaryChange" aria-label="{{copy.sb5923d1970}}">
          <view class="form-input picker-value">{{dietaryLabel}}</view>
        </picker>
      </view>
      <view class="cuisine-fieldset">
        <text class="form-label cuisine-legend">{{copy.sbf4c117c2e}}</text>
        <view class="cuisine-options">
          <view wx:for="{{cuisineOptions}}" wx:key="value" class="cuisine-chip {{cuisines.indexOf(item.value) >= 0 ? 'is-selected' : ''}}" data-value="{{item.value}}" bindtap="onCuisineTap" aria-role="button" aria-pressed="{{cuisines.indexOf(item.value) >= 0}}">
            <text>{{item.label}}</text>
            <s-icon wx:if="{{cuisines.indexOf(item.value) >= 0}}" name="check" size="28" color="{{dusk ? '#d7d1c7' : '#49553a'}}" stroke="1.75" />
          </view>
        </view>
      </view>
      <view class="preference-tip">
        <s-icon name="lightbulb" size="42" color="{{dusk ? '#d7d1c7' : '#818873'}}" stroke="1.75" />
        <text>{{copy.scd45dad838}}</text>
      </view>
      <view class="primary-button" bindtap="onPreferencesSave" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100">
        <s-icon name="check" size="35" color="#ffffff" stroke="1.75" />
        <text>{{copy.sd8ab74e175}}</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{type === 'settings'}}">
    <view class="settings-panel-content">
      <text class="field-section-title">{{copy.sba04b7c44e}}</text>
      <view class="theme-options">
        <view wx:for="{{['pearl', 'dusk']}}" wx:key="*this" class="theme-option {{theme === item ? 'is-selected' : ''}}" data-value="{{item}}" bindtap="onThemeTap" aria-role="button" aria-pressed="{{theme === item}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100">
          <view class="theme-preview theme-{{item}}" />
          <text>{{item === 'pearl' ? copy.s7927d99fd8 : copy.s4db13aa08e}}</text>
          <s-icon class="theme-option-check" wx:if="{{theme === item}}" name="check" size="30" color="{{dusk ? '#d7d1c7' : '#1b1c1a'}}" stroke="1.75" />
        </view>
      </view>
      <view class="language-setting">
        <text class="field-section-title">{{copy.s01e1787a9e}}</text>
        <picker range="{{languageOptions}}" range-key="label" value="{{languageIndex}}" bindchange="onLanguageChange" aria-label="{{copy.s01e1787a9e}}">
          <view class="language-picker"><text>{{languageOptions[languageIndex].label}}</text><s-icon color="{{dusk ? '#eeeae3' : '#1b1c1a'}}" name="chevron-right" size="30" /></view>
        </picker>
        <text class="helper-note">{{copy.sc1930e6962}}</text>
      </view>
      <view class="toggle-row" bindtap="onRemindersToggle" aria-role="switch" aria-checked="{{reminders}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100">
        <view class="toggle-copy"><text class="toggle-copy-strong">{{copy.se123603d4f}}</text><text class="toggle-copy-small">{{copy.s7e2f7bf54d}}</text></view>
        <view class="toggle-track {{reminders ? 'on' : ''}}"><view class="toggle-knob" /></view>
      </view>
      <view class="toggle-row" bindtap="onQuietToggle" aria-role="switch" aria-checked="{{reduceMotion}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100">
        <view class="toggle-copy"><text class="toggle-copy-strong">{{copy.s9df92aa74d}}</text><text class="toggle-copy-small">{{copy.s8bff07f6b6}}</text></view>
        <view class="toggle-track {{reduceMotion ? 'on' : ''}}"><view class="toggle-knob" /></view>
      </view>
      <view class="app-signature">
        <text class="app-signature-name">{{copy.s9e930e57cf}}</text><text class="app-signature-line">{{copy.sab88fdde13}}</text><text class="app-signature-version">{{copy.sc40f63ac11}}</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{type === 'privacy'}}">
    <view class="privacy-content">
      <view class="privacy-intro">
        <s-icon name="lock-keyhole" size="68" color="{{dusk ? '#d7d1c7' : '#81926b'}}" stroke="1.75" />
        <text class="privacy-title">{{copy.s8f8a180199}}</text><text class="privacy-text">{{copy.s14f83379b9}}</text>
      </view>
      <view class="toggle-row" bindtap="onPrivateToggle" aria-role="switch" aria-checked="{{privateByDefault}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100">
        <view class="toggle-copy"><text class="toggle-copy-strong">{{copy.s282ef67b06}}</text><text class="toggle-copy-small">{{copy.s53aca41c3d}}</text></view>
        <view class="toggle-track {{privateByDefault ? 'on' : ''}}"><view class="toggle-knob" /></view>
      </view>
      <view class="toggle-row" bindtap="onLocationsToggle" aria-role="switch" aria-checked="{{showLocations}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100">
        <view class="toggle-copy"><text class="toggle-copy-strong">{{copy.se31f1ed314}}</text><text class="toggle-copy-small">{{copy.s9ad623841e}}</text></view>
        <view class="toggle-track {{showLocations ? 'on' : ''}}"><view class="toggle-knob" /></view>
      </view>
      <text class="helper-note privacy-note">{{copy.s0fd2c9b152}}</text>
      <view class="secondary-button full-width" bindtap="onManageMemories" aria-role="button" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100">
        <s-icon color="{{dusk ? '#eeeae3' : '#1b1c1a'}}" name="archive" size="35" stroke="1.75" /><text>{{copy.s5a394f7f22}}</text>
      </view>
    </view>
  </block>
</view>
