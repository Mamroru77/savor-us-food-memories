.settings-editor { display: block; }
.settings-form { display: flex; flex-direction: column; gap: 35rpx; padding-bottom: 10rpx; }
.picker-value { display: flex; align-items: center; }
.cuisine-fieldset { display: flex; flex-direction: column; gap: 22rpx; }
.cuisine-legend { font-size: 27rpx; }
.cuisine-options { display: flex; gap: 17rpx; flex-wrap: wrap; }
.cuisine-chip { font-size: 25rpx; border: 1rpx solid rgba(208, 213, 196, 0.4); background: rgba(250, 251, 247, 0.31); padding: 17rpx 22rpx; border-radius: 22rpx; display: flex; align-items: center; gap: 12rpx; color: var(--muted, #565752); }
.cuisine-chip.is-selected { background: rgba(216, 222, 199, 0.4); border-color: rgba(165, 177, 142, 0.5); color: #49553a; }
.preference-tip { display: flex; align-items: flex-start; gap: 22rpx; font-size: 25rpx; line-height: 40rpx; color: var(--muted, #565752); padding: 20rpx 0; }
.field-section-title { font-size: 25rpx; font-weight: 500; margin: 8rpx 0 30rpx; display: block; }
.theme-options { display: flex; gap: 25rpx; margin-bottom: 42rpx; }
.theme-option { display: flex; position: relative; flex: 1; gap: 17rpx; align-items: center; flex-wrap: wrap; font-size: 27rpx; padding: 20rpx; border: 1rpx solid rgba(196, 204, 173, 0.33); border-radius: 27rpx; }
.theme-option.is-selected { border-color: rgba(135, 151, 112, 0.5); background: rgba(223, 229, 208, 0.14); }
.theme-option-check { margin-left: auto; }
.theme-preview { width: 100%; height: 110rpx; border-radius: 15rpx; border: 1rpx solid rgba(255, 255, 255, 0.47); box-sizing: border-box; }
.theme-pearl { background: radial-gradient(ellipse at 60% 0%, #fffdf8, #d5d8d5); }
.theme-dusk { background: radial-gradient(ellipse at 60% 0%, #7c7c7c, #3a3a3a); }
.language-setting { margin: 26rpx 0; }
.language-picker { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border: 1rpx solid var(--glass-border, #ccd1c7); border-radius: 22rpx; margin: 16rpx 0; color: var(--ink); background: var(--field, rgba(255,255,255,.3)); }
.app-signature { text-align: center; padding: 55rpx 0 18rpx; display: flex; flex-direction: column; }
.app-signature-name { font-family: var(--serif); font-size: 92rpx; line-height: 108rpx; letter-spacing: -2.5rpx; }
.app-signature-line { font-size: 25rpx; color: var(--muted, #565752); margin: 8rpx 0 25rpx; }
.app-signature-version { font-size: 20rpx; color: var(--muted, #565752); }
.privacy-content { display: flex; flex-direction: column; }
.privacy-intro { text-align: center; padding: 25rpx 12rpx 35rpx; display: flex; flex-direction: column; align-items: center; }
.privacy-title { font-family: var(--serif); font-size: 58rpx; line-height: 65rpx; margin-top: 32rpx; }
.privacy-text { font-size: 25rpx; line-height: 40rpx; color: var(--muted, #565752); margin-top: 20rpx; }
.privacy-note { margin: 45rpx 0; }
.full-width { width: 100%; }
.is-dusk .form-input { background: var(--field); color: var(--ink); border-color: var(--glass-border); }
.is-dusk .helper-note, .is-dusk .toggle-copy-small { color: var(--muted); }
.is-dusk .cuisine-chip.is-selected { background: rgba(222,200,167,.13); color: #dec8a7; border-color: rgba(222,200,167,.3); }
.is-dusk .primary-button { background: linear-gradient(145deg,#5a4d3d,#483e32); color: #f5f0e8; border: 1rpx solid rgba(222,200,167,.28); }
.is-dusk .secondary-button { background: #36373b; color: var(--ink); border-color: var(--glass-border); }
.is-dusk .theme-dusk { background: radial-gradient(ellipse at top left,#36373b,#121315); border-color: #dec8a7; }
