
/* Font tokens on :host — the single source of truth lives in app.wxss;
   this fallback keeps type consistent even if variable inheritance is
   interrupted by the component boundary. */
:host {
  --serif: 'SavorSerif', Georgia, 'PingFang SC', 'Noto Sans CJK SC', 'Microsoft YaHei', sans-serif;
  --sans: 'DMSans', -apple-system, 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;
  font-family: var(--sans);
}
/* Sheet shell — port of sheets.css (web 300px canvas × 2.5). */
.sheet-modal {
  position: fixed;
  inset: 0;
  z-index: 300;
}
.sheet-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(100, 101, 92, 0.2);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  animation: scrim-in 0.2s ease both;
}
@keyframes scrim-in { from { opacity: 0; } to { opacity: 1; } }

.sheet-panel {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: var(--sheet-top, 90px);
  bottom: calc(194rpx + env(safe-area-inset-bottom));
  height: calc(100vh - var(--sheet-top, 90px) - 194rpx - env(safe-area-inset-bottom));
  min-height: 0;
  overflow: hidden;
  border-radius: var(--radius-panel,56rpx);
  padding: var(--space-xl,56rpx) var(--space-lg,40rpx) var(--space-lg,40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  background: var(--surface-elevated,#f7f6f2);
  box-shadow: var(--shadow-floating,0 18rpx 44rpx -16rpx rgba(37,43,38,.20));
  display: flex;
  flex-direction: column;
  /* The panel surface is opaque; the scrim already provides background separation. */
  box-sizing: border-box;
  animation: sheet-up 0.32s cubic-bezier(0.2, 0.7, 0.3, 1) both;
}
@keyframes sheet-up { from { transform: translateY(140rpx); opacity: 0.6; } to { transform: translateY(0); opacity: 1; } }

.sheet-handle {
  position: absolute;
  top: 20rpx;
  left: calc(50% - 38rpx);
  width: 76rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(141, 147, 133, 0.16);
}
.sheet-heading {
  position: relative;
  padding: 0 58rpx var(--space-md,32rpx) 0;
  flex-shrink: 0;
}
.sheet-heading-copy { display: flex; flex-direction: column; }
.sheet-title {
  font-family: var(--serif);
  font-size: var(--type-page,52rpx);
  line-height: var(--leading-page,64rpx);
  letter-spacing: -0.9rpx;
}
.sheet-subtitle {
  margin-top: var(--space-xs,12rpx);
  font-size: var(--type-caption,24rpx);
  line-height: var(--leading-caption,36rpx);
  color: var(--muted, #565752);
}
.theme-dusk-panel .sheet-subtitle { color: #bcbcbc; }
.sheet-close {
  position: absolute;
  right: -12rpx;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(223, 223, 214, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}
.theme-dusk-panel .sheet-close { background: rgba(234,234,234, 0.12); }

/* Bounded panel + measured content height: no viewport-height approximation. */
.sheet-content {
  height: 0;
  flex: 1;
  min-height: 0;
  font-size: 27rpx;
}
.sheet-content-measured { flex: none; }
.sheet-end-space { height: 72rpx; flex-shrink: 0; }


/* ---------- memory detail ---------- */
.detail-photo { height: 462rpx; width: 100%; border-radius: 35rpx; background: rgba(255,255,255,.4); }
.photo-thumbnail-scroll { width:100%; height:90rpx; margin-top:20rpx; white-space:nowrap; }
.photo-thumbnails { display:flex; gap:15rpx; }
.photo-thumb {
  flex: 0 0 90rpx;
  width: 90rpx;
  height: 90rpx;
  border-radius: 17rpx;
  overflow: hidden;
  border: 5rpx solid transparent;
  opacity: 0.6;
  box-sizing: border-box;
}
.photo-thumb.is-selected { border-color: #777d64; opacity: 1; }
.photo-thumb-img { width: 100%; height: 100%; }

.detail-restaurant { display:block; font-size:30rpx; line-height:42rpx; margin-bottom:20rpx; color:var(--text,#1b1c1a); word-break:break-all; }
.detail-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25rpx;
  margin-top: 32rpx;
  font-size: 25rpx;
  color: var(--muted, #565752);
}
.detail-rating { display: flex; gap: 5rpx; }
.unfilled-star { opacity: 0.45; }
.detail-location { display: flex; align-items: center; gap: 10rpx; font-size: 25rpx; margin-top: 20rpx; color: var(--muted, #565752); }
.detail-notes {
  font-family: var(--serif);
  font-size: 52rpx;
  line-height: 65rpx;
  margin: 35rpx 0;
  display: block;
}
.detail-tags { display: flex; flex-wrap: wrap; gap: 12rpx 22rpx; color: var(--muted, #565752); font-size: 22rpx; }
.detail-tag + .detail-tag::before { content: '/'; padding-right: 22rpx; opacity: 0.4; }

.detail-action-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1.25fr;
  margin-top: 42rpx;
  padding: 30rpx 0;
  border-top: 1rpx solid rgba(138, 144, 117, 0.11);
  border-bottom: 1rpx solid rgba(138, 144, 117, 0.11);
}
.detail-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 15rpx;
  font-size: 22rpx;
  color: var(--muted, #565752);
}
.detail-action + .detail-action { border-left: 1rpx solid rgba(138, 144, 117, 0.11); }
.detail-action.is-active { color: var(--ink, #1b1c1a); }

.quiet-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  margin-top: 35rpx;
  font-size: 22rpx;
  color: var(--muted, #565752);
}
.delete-confirmation { margin-top: 35rpx; }
.delete-question { font-size: 25rpx; color: #90614d; line-height: 38rpx; margin-bottom: 22rpx; display: block; }
.delete-row { display: flex; gap: 15rpx; }
.delete-row .secondary-button { flex: 1; }
.danger-button {
  box-sizing: border-box;
  min-height: 85rpx;
  border-radius: 27rpx;
  border: 1rpx solid rgba(184, 109, 88, 0.15);
  background: rgba(184, 109, 88, 0.13);
  color: #954c38;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  padding: 17rpx 27rpx;
  font-size: 25rpx;
  flex: 1.2;
}

/* ---------- library ---------- */
.library-tabs {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 27rpx;
  background: rgba(220, 224, 212, 0.26);
}
.library-tab {
  flex: 1;
  font-size: 23rpx;
  padding: 17rpx 8rpx;
  border-radius: 20rpx;
  color: var(--muted, #565752);
  text-align: center;
  white-space: nowrap;
}
.library-tab.is-active { background: rgba(255, 255, 255, 0.73); box-shadow: 0 2rpx 12rpx rgba(101, 111, 75, 0.07); color: var(--ink, #1b1c1a); }
.theme-dusk-panel .library-tab.is-active { background: rgba(168,168,168, 0.13); color: #ededed; }

.sheet-search {
  height: 82rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.38);
  padding: 0 22rpx;
  border-radius: 25rpx;
  display: flex;
  gap: 17rpx;
  align-items: center;
  margin-top: 30rpx;
  color: var(--muted, #565752);
}
.theme-dusk-panel .sheet-search { background: rgba(168,168,168, 0.13); border-color: rgba(201,201,201, 0.2); }
.sheet-search-input { flex: 1; width: 100%; min-width: 0; font-size: 25rpx; }
.library-count { font-size: 22rpx; color: var(--muted, #565752); margin: 27rpx 2rpx 8rpx; display: block; }
.library-list { min-height: 0; }

.backup-actions { display: flex; gap: 17rpx; margin-top: 37rpx; }
.backup-actions .secondary-button { flex: 1; }
.backup-primary { flex: 1.4 !important; }
.local-note {
  margin-top: 30rpx;
  font-size: 21rpx;
  color: var(--muted, #565752);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

/* ---------- settings forms ---------- */
.settings-form { display: flex; flex-direction: column; gap: 35rpx; padding-bottom: 10rpx; }
.picker-value { display: flex; align-items: center; }

.sheet-couple { display: flex; justify-content: center; align-items: center; gap: 50rpx; margin-top: 20rpx; }
.sheet-couple-avatar { width: 152rpx; height: 152rpx; border-radius: 50%; border: 5rpx solid #fff; box-sizing: border-box; }
.together-message {
  text-align: center;
  font-family: var(--serif);
  font-size: 50rpx;
  line-height: 60rpx;
}

/* ---------- weekly ---------- */
.weekly-sheet-stats { display: flex; justify-content: center; gap: 75rpx; margin: 15rpx 0 50rpx; }
.weekly-sheet-stats .stat { gap: 15rpx; color: var(--muted, #565752); align-items: center; }
.weekly-big { font-size: 105rpx; line-height: 110rpx; color: var(--ink, #1b1c1a); }
.weekly-chart { display: flex; align-items: flex-end; gap: 30rpx; height: 212rpx; margin: 0 30rpx 60rpx; }
.weekly-bar { height: 100%; flex: 1; display: flex; justify-content: flex-end; align-items: center; flex-direction: column; position: relative; }
.weekly-bar-fill { display: block; width: 100%; border-radius: 12rpx 12rpx 5rpx 5rpx; background: linear-gradient(rgba(195, 203, 187, 0.5), rgba(181, 191, 180, 0.31)); min-height: 0; }
.weekly-bar-fill.is-highlight { background: linear-gradient(#64765a, #7f8e6b); }
.weekly-bar-letter { position: absolute; bottom: -46rpx; font-size: 20rpx; color: var(--muted, #565752); }
.weekly-reflection {
  font-family: var(--serif);
  font-size: 50rpx;
  line-height: 60rpx;
  text-align: center;
  margin-bottom: 30rpx;
  display: block;
}
.weekly-memory-list { margin-bottom: 40rpx; }

/* ---------- journey ---------- */
.journey-opening {
  font-family: var(--serif);
  font-size: 70rpx;
  line-height: 75rpx;
  padding: 20rpx 0 55rpx;
  letter-spacing: -0.6rpx;
  display: block;
}
.journey-timeline { margin-left: 12rpx; padding-left: 45rpx; border-left: 1rpx solid rgba(191, 200, 174, 0.44); margin-bottom: 55rpx; }
.timeline-stop { position: relative; padding: 0 0 55rpx; display: flex; flex-direction: column; }
.timeline-stop:last-child { padding-bottom: 0; }
.timeline-dot {
  position: absolute;
  left: -55rpx;
  top: 5rpx;
  height: 18rpx;
  width: 18rpx;
  border-radius: 50%;
  background: #a6b693;
  box-shadow: 0 0 0 10rpx #f0f1e9;
  margin-left: -4rpx;
}
.timeline-dot.is-fresh { background: #5d784f; }
.theme-dusk-panel .timeline-dot { box-shadow: 0 0 0 10rpx rgba(238,238,238, 0.12); }
.timeline-date { font-size: 21rpx; line-height: 30rpx; color: var(--muted, #565752); }
.timeline-title { font-family: var(--serif); font-size: 52rpx; line-height: 62rpx; margin: 10rpx 0; }
.timeline-text { font-size: 24rpx; color: var(--muted, #565752); line-height: 38rpx; }

/* ---------- notifications ---------- */
.notification-row {
  display: flex;
  width: 100%;
  gap: 25rpx;
  align-items: center;
  padding: 37rpx 0;
  border-bottom: 1rpx solid rgba(137, 155, 110, 0.11);
  box-sizing: border-box;
}
.notification-photo { height: 105rpx; width: 105rpx; border-radius: 25rpx; flex-shrink: 0; background: rgba(255,255,255,.4); }
.notification-symbol {
  height: 105rpx;
  width: 105rpx;
  border-radius: 25rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(227, 232, 215, 0.34);
}
.notification-copy { flex: 1; display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.notification-title { font-size: 26rpx; font-weight: 500; }
.notification-text { font-size: 24rpx; line-height: 35rpx; color: var(--muted, #565752); }
.notification-when { font-size: 20rpx; color: var(--muted, #565752); margin-top: 8rpx; }
.notifications-cta { margin-top: 50rpx; }
.caught-up { text-align: center; padding: 75rpx 0 50rpx; display: flex; flex-direction: column; align-items: center; }
.caught-up-title { font-family: var(--serif); font-size: 72rpx; line-height: 85rpx; margin-top: 38rpx; }
.caught-up-text { font-size: 25rpx; line-height: 38rpx; color: var(--muted, #565752); margin-top: 15rpx; }

/* ---------- help ---------- */
.faq-item { border-bottom: 1rpx solid rgba(133, 150, 105, 0.11); }
.faq-question {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 35rpx 0;
  font-size: 26rpx;
}
.faq-chevron { transition: transform 0.2s; }
.faq-chevron.is-open { transform: rotate(180deg); }
.faq-answer { overflow: hidden; }
.faq-answer-text { font-size: 25rpx; line-height: 40rpx; color: var(--muted, #565752); padding-bottom: 38rpx; display: block; }
.feedback-form { margin: 58rpx 0 32rpx; }
.feedback-textarea { height: 200rpx; }

.theme-dusk-panel .form-input, .theme-dusk-panel .form-textarea, .theme-dusk-panel .date-input { background:var(--field); color:var(--ink); border-color:rgba(225,225,225,.16); }
.theme-dusk-panel .helper-note, .theme-dusk-panel .toggle-copy-small { color:var(--muted); }
.theme-dusk-panel .library-tab.is-active { background:#383838; color:#f2f2f2; }
.theme-dusk-panel .primary-button { background:#444444; color:#f5f5f5; }
.theme-dusk-panel .secondary-button { background:#303030; color:#ededed; }
.theme-dusk-panel .delete-question, .theme-dusk-panel .danger-button { color:#ffc0aa; }

.theme-dusk-panel .form-placeholder { color:#aaaaaa; }

.personalization-section { margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid var(--glass-border); }
.personalization-section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 14rpx; }
.personalization-reset { font-size: 24rpx; min-height: 88rpx; display: flex; align-items: center; color: var(--muted); text-decoration: underline; }
.personalization-section .form-group + .form-group { margin-top: 24rpx; }

.theme-dusk-panel .sheet-subtitle { color:#bcbcbc; }
.theme-dusk-panel .theme-dusk { background:linear-gradient(140deg,#333333,#111111); }

/* Raised modal surface; darker inset fields clarify editability. */
.theme-dusk-panel { --ink:#eeeae3; --muted:#b6b2aa; --field:#1c1d20; --glass-border:rgba(238,234,227,.12); background:linear-gradient(160deg,#303135,#25262a); color:var(--ink); border-color:rgba(238,234,227,.16); box-shadow:0 -16rpx 72rpx #0006,inset 0 1rpx 0 #ffffff12; }
.theme-dusk-panel .sheet-subtitle, .theme-dusk-panel .helper-note, .theme-dusk-panel .toggle-copy-small { color:var(--muted); }
.theme-dusk-panel .form-input, .theme-dusk-panel .form-textarea, .theme-dusk-panel .date-input, .theme-dusk-panel .sheet-search { background:var(--field); color:var(--ink); border-color:var(--glass-border); }
.theme-dusk-panel .form-placeholder { color:#a9a69f; }
.theme-dusk-panel .library-tab.is-active { background:rgba(222,200,167,.13); color:#dec8a7; border-color:rgba(222,200,167,.3); }
.theme-dusk-panel .primary-button { background:linear-gradient(145deg,#5a4d3d,#483e32); color:#f5f0e8; border:1rpx solid rgba(222,200,167,.28); }
.theme-dusk-panel .secondary-button { background:#36373b; color:var(--ink); border-color:var(--glass-border); }
.theme-dusk-panel .personalization-reset { color:#dec8a7; }

.theme-dusk-panel .weekly-bar-fill.is-highlight { background:linear-gradient(#dec8a7,#9b8465); }
.detail-business { display:flex; flex-direction:column; gap:14rpx; margin:20rpx 0; color:var(--muted); }

/* Exit keeps the last rendered sheet type while parent clears its request. */
.sheet-leaving { pointer-events:none; }
.sheet-leaving .sheet-scrim { animation:sheet-scrim-out 320ms ease both; }
.sheet-leaving .sheet-panel { animation:sheet-panel-out 320ms cubic-bezier(.333333,0,.666667,1) both; }
@keyframes sheet-scrim-out { to {opacity:0;} }
@keyframes sheet-panel-out { to {transform:translateY(140rpx);opacity:0;} }
.quiet .sheet-panel,.quiet .sheet-scrim,.quiet .faq-chevron { animation:none!important;transition:none!important; }

.faq-answer { transition:height 320ms cubic-bezier(.333333,0,.666667,1),opacity 220ms ease; }
.quiet .faq-answer { transition:none; }

.detail-action,.library-tab,.cuisine-chip,.theme-option { transition:background-color 180ms ease,border-color 180ms ease; }
.detail-action-icon { display:block;transform:scale(1);transition:transform 180ms ease; }
.is-active .detail-action-icon { transform:scale(1.06); }
.quiet .detail-action,.quiet .library-tab,.quiet .cuisine-chip,.quiet .theme-option,.quiet .detail-action-icon { transition:none; }

/* Shared shell callers: all 13 sheets; close glyph/material remain unchanged. */
.danger-button { min-height:var(--control-height,88rpx); border-radius:var(--control-radius,27rpx); }
.sheet-heading { padding-right:88rpx; }
.sheet-heading-copy { min-width:0; }
.sheet-title, .sheet-subtitle { overflow-wrap:break-word; }
.sheet-close { width:88rpx; height:88rpx; right:-28rpx; top:-16rpx; background:transparent; }
.theme-dusk-panel .sheet-close { background:transparent; }
.sheet-close::before { content:""; position:absolute; width:56rpx; height:56rpx; border-radius:50%; background:rgba(223,223,214,.25); }
.theme-dusk-panel .sheet-close::before { background:rgba(234,234,234,.12); }
.sheet-close s-icon { position:relative; }
.detail-meta { gap:16rpx; flex-wrap:wrap; }
.detail-action { min-width:0; overflow-wrap:break-word; }
.library-tab, .cuisine-chip { min-height:88rpx; box-sizing:border-box; }
.library-tab.is-active { text-decoration:underline; text-underline-offset:8rpx; }

.library-tab { display:flex; align-items:center; justify-content:center; white-space:normal; min-width:0; }
.sheet-search { height:88rpx; box-sizing:border-box; }
.sheet-search-input { min-height:86rpx; }
.quiet-delete { min-height:88rpx; }
.cloud-feedback-link{width:100%;box-sizing:border-box;margin-top:20rpx}
