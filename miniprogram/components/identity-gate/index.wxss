.gate{--ink:#1b1c1a;--muted:#565752;padding:calc(180rpx + env(safe-area-inset-top)) 44rpx calc(100rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:28rpx;min-height:100vh;box-sizing:border-box;color:var(--ink);background:linear-gradient(143deg,#f0f0ef,#eeece9 42%,#e7e6e3);font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;font-size:27rpx;line-height:42rpx}
.gate-brand{font-size:22rpx;line-height:32rpx;letter-spacing:4rpx;color:var(--muted)}
.title{font-size:46rpx;line-height:64rpx;font-weight:400;overflow-wrap:break-word}
.gate-copy{color:var(--muted);font-size:25rpx;line-height:40rpx}
.gate-button{display:flex;align-items:center;justify-content:center;min-height:98rpx;width:100%;margin:8rpx 0 0;padding:22rpx 28rpx;box-sizing:border-box;border:2rpx solid #ffffffcc;border-radius:60rpx;background:linear-gradient(150deg,#31322f,#181a17);color:#fff;font-size:27rpx;line-height:40rpx;white-space:normal}
.gate-button::after{border:0}.gate-button.ui-disabled{opacity:.78;color:#fff !important;background:linear-gradient(150deg,#31322f,#181a17) !important}.dusk .gate-button.ui-disabled{color:#f5f0e8 !important;background:linear-gradient(145deg,#5a4d3d,#483e32) !important}.gate-pressed{opacity:.85}
.gate-message{padding:20rpx 22rpx;border-radius:20rpx;background:rgba(245,218,208,.4);color:#994d3d;font-size:24rpx;line-height:38rpx;overflow-wrap:anywhere}
.gate.dusk{--ink:#eeeae3;--muted:#b6b2aa;background:radial-gradient(ellipse at 25% 0%,#eeeae311,transparent 58%),#121315}
.dusk .gate-button{background:linear-gradient(145deg,#5a4d3d,#483e32);color:#f5f0e8;border-color:#dec8a747}.dusk .gate-message{background:#8c392b3d;color:#ffc0aa}
