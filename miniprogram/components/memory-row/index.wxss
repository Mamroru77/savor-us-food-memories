
/* Font tokens on :host — the single source of truth lives in app.wxss;
   this fallback keeps type consistent even if variable inheritance is
   interrupted by the component boundary. */
:host {
  --serif: 'SavorSerif', Georgia, 'PingFang SC', 'Noto Sans CJK SC', 'Microsoft YaHei', sans-serif;
  --sans: 'DMSans', -apple-system, 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;
  font-family: var(--sans);
}
/* web: .memory-row (screens.css) — 64px min-height, 11px gap, hairline dividers */
.memory-row {
  width: 100%;
  min-height: 168rpx;
  display: flex;
  align-items: center;
  gap: var(--space-sm,24rpx);
  border-bottom: 1rpx solid rgba(52, 53, 52, 0.07);
  padding: 20rpx 0;
  box-sizing: border-box;
}
.memory-row:last-child { border-bottom: 0; }

.memory-row-photo {
  height: 128rpx;
  width: 112rpx;
  flex-shrink: 0;
  border-radius: var(--radius-image,28rpx);
  background: rgba(255, 255, 255, 0.4);
}

.memory-row-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
  font-size: var(--type-caption,24rpx);
  line-height: 34rpx;
  color: var(--muted, #565752);
}
.memory-row-title {
  font-weight: 500;
  font-size: 30rpx;
  line-height: 40rpx;
  margin-bottom: 5rpx;
  color: var(--ink, #1b1c1a);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.memory-row-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
