@import "styles/visual-tokens.wxss";
/* Fonts are loaded once for webview and native scopes by utils/fonts.js. */
page {
  /* palette */
  --ink: #1b1c1a;
  --muted: #565752;
  --glass: rgba(252, 251, 249, 0.45);
  --glass-border: rgba(255, 255, 255, 0.7);
  --field: rgba(255, 255, 255, 0.48);
  --serif: 'SavorSerif', Georgia, 'PingFang SC', 'Noto Sans CJK SC', 'Microsoft YaHei', sans-serif;
  --sans: 'DMSans', -apple-system, 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;

  /* tab bar system tokens (tab bar + bottom spacers share these) */
  --tabbar-height: 170rpx;
  --tabbar-gap: 26rpx;
  /* total clearance pages must reserve under scrolling content */
  --tab-clearance: calc(var(--tabbar-height) + var(--tabbar-gap) + env(safe-area-inset-bottom));

  font-family: var(--sans);
  color: var(--ink);
  font-size: 26rpx;
  line-height: 38rpx;
}

/* ---------- shared page scaffolding ---------- */
/* Pages scroll with the page itself (most reliable on real devices);
   the map screen re-enables its own fixed viewport via .map-screen. */
.screen {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: var(--surface-page);
}

.screen-wallpaper {
  /* fixed: stays a stable blurred backdrop while the page scrolls */
  position: fixed;
  top: -160rpx;
  left: -100rpx;
  right: -100rpx;
  bottom: -160rpx;
  z-index: 0;
  opacity: 0.17;
  /* rpx is unreliable inside filter on some devices — px here on purpose.
     Warmer + softer so glass cards melt visible color, not flat gray. */
  filter: blur(60px) grayscale(0.7);
  pointer-events: none;
}

.screen-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
}

/* Dynamic ambient light: the featured photo (Home: weekly photo, Add:
   current draft photo, Us/Me: page artwork) blurred into a soft field.
   Fitted against the concept mockup by pixel-sampling: LOW opacity +
   LOW blur keeps the silhouette faintly readable; the translate places
   the subject's dark mass behind the hero card like the mockup. */
.ambient-photo {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  opacity: var(--ambient-opacity);
  filter: blur(10px) saturate(1.08);
  transform: translate(-9.6%, 5.5%) scale(1.35);
  pointer-events: none;
}
.quiet .ambient-photo { transition: none !important; animation: none !important; }

/* every tab page ends its scroll content with this spacer so the
   floating tab bar never covers content (token-driven, no guessing) */
.tab-spacer {
  width: 100%;
  height: calc(var(--tab-clearance) + 24rpx);
}

/* ---------- typography helpers ---------- */
.serif { font-family: var(--serif); font-weight: 400; }

.screen-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.screen-heading .heading-title {
  font-family: var(--serif);
  font-size: var(--type-page);
  line-height: var(--leading-page);
  letter-spacing: -0.5rpx;
}
.screen-heading .heading-sub {
  margin-top: var(--space-xs);
  font-size: 26rpx;
  line-height: var(--leading-body);
  color: var(--muted);
}

/* ---------- primitives ---------- */
.glass {
  background: var(--surface-card);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: var(--shadow-card);
  -webkit-backdrop-filter: blur(42rpx);
  backdrop-filter: blur(42rpx);
}

.stat { display: flex; flex-direction: column; font-size: 25rpx; line-height: 35rpx; }
.stat-strong { font-family: var(--serif); font-weight: 400; letter-spacing: -1rpx; }

.primary-button {
  min-height: 98rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 60rpx;
  background: linear-gradient(150deg, #31322f, #181a17);
  color: #fff;
  font-size: 29rpx;
  font-weight: 450;
  box-shadow: 0 8rpx 18rpx -8rpx rgba(17, 17, 17, 0.33), inset 0 0 0 2rpx #10120f;
  padding: 22rpx 35rpx;
  box-sizing: border-box;
}
.primary-button.ghosted { opacity: 0.6; }

.secondary-button {
  min-height: 85rpx;
  border-radius: 27rpx;
  border: 1rpx solid rgba(212, 215, 202, 0.44);
  background: rgba(229, 231, 221, 0.36);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  padding: 17rpx 27rpx;
  font-size: 25rpx;
  box-sizing: border-box;
}

.form-error {
  margin: 22rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  line-height: 38rpx;
  color: #994d3d;
  background: rgba(245, 218, 208, 0.5);
}

.empty-state {
  width: 100%;
  padding: 62rpx 20rpx;
  font-size: 27rpx;
  line-height: 45rpx;
  text-align: center;
  color: var(--muted);
}
.empty-state .empty-action { display: inline-block; margin-top: 22rpx; text-decoration: underline; text-underline-offset: 8rpx; }

.helper-note { font-size: 24rpx; line-height: 38rpx; color: var(--muted, #565752); }

/* ---------- form fields ---------- */
.form-field { display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.form-label { font-size: 25rpx; line-height: 32rpx; font-weight: 600; }
.form-input,
.form-textarea {
  width: 100%;
  min-height: 82rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  background: var(--field);
  border-radius: 27rpx;
  padding: 17rpx 22rpx;
  font-size: 27rpx;
  line-height: 40rpx;
  box-sizing: border-box;
  color: var(--ink);
}
.form-placeholder { color: var(--muted, #565752); }

/* ---------- toggle ---------- */
.toggle-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-align: left;
  gap: 38rpx;
  padding: 35rpx 0;
  border-bottom: 1rpx solid rgba(144, 156, 120, 0.13);
}
.toggle-copy { display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.toggle-copy-strong { font-size: 27rpx; line-height: 38rpx; font-weight: 500; }
.toggle-copy-small { font-size: 22rpx; line-height: 35rpx; color: var(--muted); }
.toggle-track {
  height: 52rpx;
  width: 88rpx;
  flex-shrink: 0;
  background: #c5cbbd;
  padding: 8rpx;
  border-radius: 38rpx;
  transition: background 0.2s;
  box-sizing: border-box;
}
.toggle-knob {
  display: block;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(62, 78, 37, 0.11);
  transition: transform 0.2s;
}
.toggle-track.on { background: #68765b; }
.toggle-track.on .toggle-knob { transform: translateX(36rpx); }

/* ---------- toast ---------- */
.savor-toast {
  position: fixed;
  z-index: 500;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(var(--tab-clearance) + 16rpx);
  width: 620rpx;
  max-width: calc(100vw - 64rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 27rpx;
  padding: 32rpx 32rpx 32rpx 40rpx;
  background: rgba(37, 41, 33, 0.96);
  color: #fcfcf7;
  border: 1rpx solid rgba(243, 244, 232, 0.14);
  border-radius: 38rpx;
  box-shadow: 0 20rpx 60rpx rgba(34, 42, 28, 0.15);
  font-size: 28rpx;
  line-height: 45rpx;
}
.savor-toast-text { flex: 1; }

/* ---------- quiet motion (reduceMotion setting) ---------- */
.quiet .anim,
.quiet .screen-wallpaper { transition: none !important; animation: none !important; }

@keyframes savor-spin { to { transform: rotate(360deg); } }
.spin { animation: savor-spin 0.9s linear infinite; }

/* Nocturne — layered charcoal, warm paper text, one champagne accent.
   Keep this token set distinct from the unchanged pearl/light theme. */
.dusk {
  --ink: #eeeae3; --muted: #b6b2aa;
  --accent: #dec8a7;
  --glass: linear-gradient(155deg,rgba(43,44,47,.90),rgba(28,29,32,.90));
  --glass-border: rgba(238,234,227,.12);
  --field: #1c1d20;
  color:var(--ink);
  background:radial-gradient(ellipse at 25% 0%,rgba(238,234,227,.065),transparent 58%),#121315;
}
.dusk .ambient-photo { opacity:.055; filter:blur(18px) grayscale(1); }
.dusk .primary-button { background:linear-gradient(145deg,#5a4d3d,#483e32); color:#f5f0e8; border:1rpx solid rgba(222,200,167,.28); box-shadow:inset 0 1rpx 0 #ffffff14,0 10rpx 24rpx #0003; }
.dusk .secondary-button { background:#2b2c30; color:var(--ink); border-color:var(--glass-border); }
.dusk .form-input, .dusk .form-textarea, .dusk .date-input { color:var(--ink); background:var(--field); border-color:var(--glass-border); }
.dusk .form-placeholder { color:#a9a69f; }
.dusk .toggle-track { background:#48494e; }
.dusk .toggle-track.on { background:#dec8a7; }
.dusk .toggle-knob { background:#eeeae3; }
.dusk .toggle-track.on .toggle-knob { background:#302a23; }
.dusk .glass { background:var(--glass); border-color:var(--glass-border); box-shadow:0 18rpx 48rpx -18rpx #0008,inset 0 1rpx 0 #ffffff0d; }
.dusk .helper-note, .dusk .form-label { color:var(--muted); }
.dusk .form-error { color:#ffc0aa; background:rgba(140,57,43,.24); }

/* Shared content-card material: one source for Home / Map / Us / Me.
   Search fields, transient popovers and photos intentionally remain separate. */
.screen {
  --content-card-bg: var(--surface-card);
  --content-card-border: rgba(255, 255, 255, 0.48);
  --content-card-shadow: var(--shadow-card);
  --content-card-blur: 20px;
}
.screen.dusk {
  --content-card-bg: linear-gradient(155deg,rgba(43,44,47,.90),rgba(28,29,32,.90));
  --content-card-border: rgba(238,234,227,.12);
  --content-card-shadow: 0 22rpx 56rpx -22rpx rgba(0,0,0,.55), inset 0 1rpx 0 rgba(255,255,255,.065);
}
.screen .content-card {
  background: var(--content-card-bg);
  border-color: var(--content-card-border);
  box-shadow: var(--content-card-shadow);
  -webkit-backdrop-filter: blur(var(--content-card-blur));
  backdrop-filter: blur(var(--content-card-blur));
}
/* Only Chinese display typography is tuned; body copy and Latin numerals keep
   their existing sizes. Avoid the old automatic Songti/SimSun fallback. */
.locale-zh .home-intro-title text:last-child { font-size: 64rpx; line-height: 88rpx; letter-spacing: 1rpx; font-weight: 400; }
.locale-zh .screen-heading .heading-title { font-size: var(--type-page-zh); line-height: var(--leading-page); letter-spacing: 1rpx; font-weight: 400; }
.locale-zh .add-title { font-size: var(--type-page-zh); line-height: var(--leading-page); letter-spacing: .6rpx; font-weight: 400; }
.locale-zh .section-title { font-size: 30rpx; line-height: 42rpx; letter-spacing: .4rpx; font-weight: 500; }
.locale-zh .sheet-title { font-size: 48rpx; line-height: 66rpx; letter-spacing: .6rpx; font-weight: 400; }

/* Custom headings stay inside the original header slots. Full text remains editable. */
.home-intro-title text, .heading-title, .heading-sub, .add-title, .add-subtitle { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 100%; }
.screen-heading > view:first-child, .add-heading-copy { min-width: 0; flex: 1; }

.home-intro-sub { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

/* Shared restrained interaction motion. Hidden popovers never intercept taps. */
.motion-popover { opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-10rpx) scale(.98);transform-origin:top right;transition:opacity 320ms cubic-bezier(.333333,0,.666667,1),transform 320ms cubic-bezier(.333333,0,.666667,1),visibility 0s 320ms; }
.motion-popover.motion-visible { opacity:1;visibility:visible;pointer-events:auto;transform:translateY(0) scale(1);transition-delay:0s; }
.quiet .motion-popover { transition:none; }

/* UI audit: semantic aliases, not a redesign. Tab / Map geometry is excluded. */
page {
  --control-height: 88rpx;
  --control-radius: var(--radius-control);
  --field-font-size: 27rpx;
  --field-line-height: 40rpx;
  --caption-size: 24rpx;
}
.form-input, .form-textarea {
  min-height: var(--control-height);
  border-radius: var(--control-radius);
  font-size: var(--field-font-size);
  line-height: var(--field-line-height);
}
.secondary-button { min-height:var(--control-height); border-radius:var(--control-radius); }
.helper-note { font-size:var(--caption-size); }
.is-focused { box-shadow:inset 0 0 0 2rpx var(--muted, #565752); }
.has-error { box-shadow:inset 0 0 0 2rpx #994d3d; }
.dusk .has-error, .theme-dusk-panel .has-error { box-shadow:inset 0 0 0 2rpx #ffc0aa; }
.field-error { margin:8rpx 0 0; }
.ui-pressed { opacity:.85; }
.quiet .spin { animation:none !important; }
/* Intrinsic text growth rather than global clipping or forced new typography. */
.form-label, .form-error, .heading-sub, .primary-button text, .secondary-button text { overflow-wrap:break-word; }
.primary-button, .secondary-button { white-space:normal; }
