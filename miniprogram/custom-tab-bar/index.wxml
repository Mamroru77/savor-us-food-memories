<view wx:if="{{presentationReady}}" class="tab-bar {{dusk ? 'theme-dusk' : ''}} {{quiet ? 'theme-quiet' : ''}}">
  <block wx:for="{{list}}" wx:key="pagePath">
    <!-- central Add button -->
    <view
      wx:if="{{item.add}}"
      class="tab-add"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="onTabTap"
      aria-role="tab"
      aria-selected="{{viewState.selected === index}}"
      aria-label="{{addLabel}}"
    >
      <view class="tab-add-button" hover-class="add-press" hover-start-time="0" hover-stay-time="120">
        <view class="tab-add-icon {{viewState.selected === index && enterPulse === 1 ? 'tab-add-spring-a' : ''}} {{viewState.selected === index && enterPulse === 2 ? 'tab-add-spring-b' : ''}}">
          <s-icon class="tab-s-icon" data-index="{{index}}" name="{{viewState.icons[index].icon}}" size="66" color="{{viewState.icons[index].color}}" stroke="1.75" />
        </view>
      </view>
    </view>
    <!-- regular tab -->
    <view
      wx:else
      class="tab-item {{viewState.selected === index ? 'is-active' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="onTabTap"
      hover-class="tab-press"
      hover-start-time="0"
      hover-stay-time="100"
      aria-role="tab"
      aria-selected="{{viewState.selected === index}}"
      aria-label="{{labels[index] || item.text}}"
    >
      <view class="tab-icon-wrap {{viewState.selected === index && enterPulse === 1 ? 'tab-spring-a' : ''}} {{viewState.selected === index && enterPulse === 2 ? 'tab-spring-b' : ''}}">
        <s-icon class="tab-s-icon" data-index="{{index}}" name="{{viewState.icons[index].icon}}" size="{{item.size}}" color="{{viewState.icons[index].color}}" stroke="1.75" />
      </view>
      <view class="tab-label-stack">
        <text class="tab-label tab-label-sizer" aria-hidden="true">{{labels[index] || item.text}}</text>
        <text class="tab-label tab-label-layer tab-label-inactive">{{labels[index] || item.text}}</text>
        <text class="tab-label tab-label-layer tab-label-active" aria-hidden="true">{{labels[index] || item.text}}</text>
      </view>
    </view>
  </block>
</view>
