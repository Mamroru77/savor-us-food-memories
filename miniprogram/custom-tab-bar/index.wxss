
/* Font tokens on :host — the single source of truth lives in app.wxss;
   this fallback keeps type consistent even if variable inheritance is
   interrupted by the component boundary. */
:host {
  --serif: 'SavorSerif', Georgia, 'PingFang SC', 'Noto Sans CJK SC', 'Microsoft YaHei', sans-serif;
  --sans: 'DMSans', -apple-system, 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;
  font-family: var(--sans);
}
/* Floating glass tab bar — tokens mirror app.wxss
   (--tabbar-height: 170rpx, --tabbar-gap: 26rpx).
   Each TabBar owns its route's active Lucide icon (zero cross-WebView rewind);
   arrival plays a 280ms GPU-composited Soft Tactile Spring from scale(1). */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  height: calc(170rpx + env(safe-area-inset-bottom));
  padding: 6rpx 20rpx calc(26rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(rgba(249, 248, 246, 0.66), rgba(246, 246, 244, 0.84));
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(55rpx);
  -webkit-backdrop-filter: blur(55rpx);
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 24rpx;
  line-height: 30rpx;
  color: #828480;
  transition: color 0.2s, opacity 0.15s;
}
.tab-item.is-active { color: #171a16; }

.tab-label-stack { position: relative; display: inline-flex; align-items: center; justify-content: center; height: 30rpx; line-height: 30rpx; }
.tab-label { display: block; line-height: 30rpx; white-space: nowrap; }
.tab-label-sizer { visibility: hidden; font-weight: 600; pointer-events: none; }
.tab-label-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; height: 30rpx; line-height: 30rpx; text-align: center; transition: opacity 160ms ease; pointer-events: none; }
.tab-label-inactive { color: #828480; font-weight: 400; opacity: 1; }
.tab-label-active { color: #171a16; font-weight: 600; opacity: 0; }
.tab-item.is-active .tab-label-inactive { opacity: 0; }
.tab-item.is-active .tab-label-active { opacity: 1; }

.tab-icon-wrap {
  display: flex;
  will-change: transform;
  transform: translate3d(0, 0, 0) scale(1);
}
.tab-spring-a { animation: tab-spring-a 280ms cubic-bezier(0.22, 1, 0.36, 1) both; }
.tab-spring-b { animation: tab-spring-b 280ms cubic-bezier(0.22, 1, 0.36, 1) both; }
@keyframes tab-spring-a {
  0%   { transform: translate3d(0, 0, 0) scale(1); }
  22%  { transform: translate3d(0, 1rpx, 0) scale(0.92); }
  58%  { transform: translate3d(0, -2rpx, 0) scale(1.08); }
  82%  { transform: translate3d(0, 0, 0) scale(0.99); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}
@keyframes tab-spring-b {
  0%   { transform: translate3d(0, 0, 0) scale(1); }
  22%  { transform: translate3d(0, 1rpx, 0) scale(0.92); }
  58%  { transform: translate3d(0, -2rpx, 0) scale(1.08); }
  82%  { transform: translate3d(0, 0, 0) scale(0.99); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}

.tab-press { opacity: 0.7; }

.tab-add {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-add-button {
  width: 130rpx;
  height: 130rpx;
  margin-top: -14rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.97), rgba(217, 217, 215, 0.83));
  box-shadow: 0 18rpx 28rpx -5rpx rgba(59, 62, 61, 0.21), 0 0 0 18rpx rgba(248, 248, 246, 0.27), inset 0 2rpx 5rpx #ffffff;
  box-sizing: border-box;
  transition: opacity 0.15s ease, box-shadow 0.18s ease;
}
/* Outer orb/halo stays rock-solid; only inner Lucide utensil glyph springs. */
.tab-add-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  will-change: transform;
  transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
}
.tab-add-spring-a { animation: tab-add-spring-a 280ms cubic-bezier(0.22, 1, 0.36, 1) both; }
.tab-add-spring-b { animation: tab-add-spring-b 280ms cubic-bezier(0.22, 1, 0.36, 1) both; }
@keyframes tab-add-spring-a {
  0%   { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
  22%  { transform: translate3d(0, 0, 0) scale(0.90) rotate(-3deg); }
  58%  { transform: translate3d(0, 0, 0) scale(1.08) rotate(2deg); }
  82%  { transform: translate3d(0, 0, 0) scale(0.99) rotate(-0.5deg); }
  100% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
}
@keyframes tab-add-spring-b {
  0%   { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
  22%  { transform: translate3d(0, 0, 0) scale(0.90) rotate(-3deg); }
  58%  { transform: translate3d(0, 0, 0) scale(1.08) rotate(2deg); }
  82%  { transform: translate3d(0, 0, 0) scale(0.99) rotate(-0.5deg); }
  100% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
}
/* Preserve tactile feedback without moving the circle, glyph or halo. */
.add-press { opacity: 0.85; }

/* Quiet motion (reduceMotion setting) removes every tab animation */
.theme-quiet .tab-item,
.theme-quiet .tab-icon-wrap,
.theme-quiet .tab-add-button,
.theme-quiet .tab-add-icon,
.theme-quiet .tab-label { transition: none !important; animation: none !important; }
.theme-quiet .tab-icon-wrap,
.theme-quiet .tab-add-icon { transform: none !important; }

/* Navigation has its own elevation, not another content card. */
.theme-dusk.tab-bar { background:linear-gradient(rgba(26,23,20,.90),rgba(18,16,14,.97)); border-top-color:rgba(236,224,206,.11); box-shadow:0 -14rpx 42rpx rgba(0,0,0,.35); }
.theme-dusk .tab-item { color:#a99f93; }
.theme-dusk .tab-item.is-active { color:#dfc7a4; }
.theme-dusk .tab-label-inactive { color:#a99f93; }
.theme-dusk .tab-label-active { color:#dfc7a4; }
.theme-dusk .tab-add-button { background:linear-gradient(145deg,#f0e3ce,#cfb48d); border-color:#f6ebd9; box-shadow:0 14rpx 32rpx rgba(0,0,0,.45),0 0 0 12rpx rgba(223,199,164,.08),inset 0 2rpx 3rpx #ffffff88; }
