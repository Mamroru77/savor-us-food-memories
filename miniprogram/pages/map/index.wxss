/* Map — port of screens.css “Map” (×2.5); Leaflet replaced by native <map>.
   Header is in normal flow (same padding-top source as the Us screen) and
   the native map starts below the search bar, so its attribution watermark
   can never overlap the heading. */
.map-screen { overflow: hidden; height: 100vh; }

.memory-map {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.map-fallback {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: linear-gradient(160deg, #e8e9e4, #dfe0dd);
  padding: 0 90rpx;
  box-sizing: border-box;
}
.map-fallback-title { font-family: var(--serif); font-size: 46rpx; margin-top: 20rpx; }
.map-fallback-text { font-size: 25rpx; color: var(--muted, #565752); text-align: center; line-height: 40rpx; }
.map-fallback-button { margin-top: 20rpx; font-size: 27rpx; text-decoration: underline; text-underline-offset: 8rpx; }

.map-head {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 4;
  padding-left: 35rpx;
  padding-right: 35rpx;
}
.map-top-fade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 380rpx;
  pointer-events: none;
  background: linear-gradient(rgba(238, 237, 235, 0.94) 30%, rgba(238, 237, 235, 0));
  z-index: 2;
}
.dusk .map-top-fade { background: linear-gradient(rgba(73,73,73, 0.92), rgba(73,73,73, 0)); }
.map-heading { margin: 0 8rpx; }
.map-heading .heading-title { display: block; }
.map-heading .heading-sub { display: block; }

.map-search {
  position: relative;
  margin-top: 26rpx;
  height: 95rpx;
  border-radius: 37rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 22rpx 0 30rpx;
  background: rgba(255, 255, 255, 0.81);
  z-index: 6;
  box-shadow: 0 22rpx 40rpx -25rpx rgba(66, 67, 63, 0.33);
  box-sizing: border-box;
}
.dusk .map-search { background: rgba(72,72,72, 0.91); }
.map-search-input { flex: 1; width: 100%; min-width: 0; font-size: 24rpx; height: 100%; }
.map-search-placeholder { color: var(--muted, #565752); }
.map-clear { width: 40rpx; display: flex; justify-content: center; }
.map-filter-button {
  width: 56rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.filter-active { background: #d5dccf; }

.map-filter-menu {
  position: absolute;
  z-index: 8;
  left: 42rpx;
  right: 42rpx;
  border-radius: 37rpx;
  background: rgba(248, 248, 244, 0.96);
  padding: 30rpx;
  box-shadow: 0 25rpx 60rpx rgba(67, 73, 60, 0.2);
  box-sizing: border-box;
}
.dusk .map-filter-menu { background: rgba(72,72,72, 0.95); }
.map-filter-label { display: block; margin-bottom: 15rpx; font-size: 22rpx; color: var(--muted, #565752); }
.map-filter-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 22rpx 10rpx;
  font-size: 27rpx;
  border-bottom: 1rpx solid rgba(89, 92, 79, 0.05);
  box-sizing: border-box;
}
.map-filter-option:last-child { border-bottom: 0; }

.recenter-map {
  position: absolute;
  z-index: 5;
  right: 42rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.89);
  box-shadow: 0 12rpx 22rpx rgba(85, 85, 85, 0.13);
}
.dusk .recenter-map { background: rgba(73,73,73, 0.94); }

.map-results-count {
  position: absolute;
  z-index: 3;
  left: 52rpx;
  font-size: 22rpx;
  padding: 8rpx 15rpx;
  border-radius: 10rpx;
  background: rgba(247, 247, 241, 0.74);
  color: var(--muted, #565752);
}

.place-card {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(var(--tab-clearance) + 20rpx);
  height: 340rpx;
  border-radius: 45rpx;
  z-index: 5;
}
.place-open {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 17rpx;
  width: calc(100% - 310rpx);
  height: 270rpx;
  padding: 30rpx 20rpx 20rpx 36rpx;
  box-sizing: border-box;
}
.place-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}
.place-name {
  font-family: var(--serif);
  font-size: 42rpx;
  line-height: 54rpx;
  font-weight: 500;
  letter-spacing: 0;
  margin-bottom: 10rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.place-line {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--muted, #565752);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.place-date { margin-top: 12rpx; padding-right:60rpx; box-sizing:border-box; font-size:24rpx; line-height:34rpx; font-weight:400; }
.place-photo {
  position:absolute;
  top:30rpx;
  bottom:30rpx;
  right:30rpx;
  width: 280rpx;
  height: 280rpx;
  box-sizing:border-box;
  border-radius: 30rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.4);
}
.bookmark-place {
  position: absolute;
  right: 326rpx;
  bottom: 94rpx;
  width: 55rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-empty {
  position: absolute;
  z-index: 4;
  left: 50rpx;
  right: 50rpx;
  bottom: calc(var(--tab-clearance) + 40rpx);
  border-radius: 45rpx;
  padding: 55rpx 38rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.map-empty-title { font-family: var(--serif); font-size: 58rpx; line-height: 68rpx; margin-top: 30rpx; }
.map-empty-text { margin: 15rpx 0 38rpx; font-size: 25rpx; color: var(--muted, #565752); }
.map-empty-button { font-size: 27rpx; text-decoration: underline; text-underline-offset: 10rpx; }


.place-location-actions { display:flex; gap:16rpx; padding:0 0 0 100rpx; width:calc(100% - 310rpx); box-sizing:border-box; height:65rpx; align-items:center; font-size:22rpx; line-height:28rpx; color:var(--muted); }

/* Compact pending-location affordance directly beneath the recenter control. */
.pending-location-controls { margin-top:108rpx; position:absolute; right:42rpx; z-index:7; }
.pending-bubble { margin-left:auto; width:88rpx; min-height:60rpx; border-radius:32rpx; display:flex; align-items:center; justify-content:center; gap:6rpx; font-size:24rpx; background:rgba(251,250,247,.76); }
.pending-popover { position:absolute; right:0; top:76rpx; width:460rpx; max-width:calc(100vw - 84rpx); box-sizing:border-box; padding:28rpx; border-radius:30rpx; background:rgba(251,250,247,.92); box-shadow:0 16rpx 40rpx #18291d22; }
.pending-popover-heading { display:flex; justify-content:space-between; align-items:center; gap:18rpx; font-weight:500; font-size:26rpx; }
.pending-close { font-size:36rpx; padding:8rpx; }
.pending-explainer { display:block; margin-top:16rpx; font-size:24rpx; color:var(--muted); line-height:36rpx; }
.pending-action { margin-top:22rpx; padding:18rpx 24rpx; border-radius:20rpx; background:#293b31; color:#f7faf5; text-align:center; font-size:25rpx; }
.map-demo-note { position:absolute; right:42rpx; z-index:5; font-size:22rpx; padding:8rpx 14rpx; border-radius:12rpx; background:rgba(251,250,247,.74); color:#404f44; }
.map-night-veil { position:absolute; inset:0; background:rgba(0,0,0,.3); pointer-events:none; z-index:1; }
.dusk .map-search, .dusk .recenter-map, .dusk .pending-bubble { background:rgba(28,28,28,.9); }
.dusk .pending-popover, .dusk .map-filter-menu { background:rgba(26,26,26,.95); }
.dusk .map-top-fade { background:linear-gradient(rgba(14,14,14,.96), rgba(14,14,14,0)); }
.dusk .map-fallback { background:linear-gradient(150deg,#141414,#252525); }
.dusk .map-demo-note, .dusk .map-results-count { background:#282828; color:#dddddd; }
.dusk .map-search-placeholder, .dusk .map-filter-label { color:#b6b2aa; }
.dusk .filter-active { background:#474747; }

.place-line { color:#253329; }
.dusk .place-line { color:#b6b2aa; }

.dusk .map-search, .dusk .recenter-map, .dusk .pending-bubble { background:rgba(37,38,42,.94); border-color:rgba(238,234,227,.12); }
.dusk .pending-popover, .dusk .map-filter-menu { background:#2b2c30; border-color:rgba(238,234,227,.12); }
.dusk .map-top-fade { background:linear-gradient(rgba(18,19,21,.96),rgba(18,19,21,0)); }
.dusk .filter-active { background:#5a4d3d; color:#f5f0e8; }

/* Native 2D composition surface: off-screen, not display:none. */
.marker-render-canvas { position:fixed; left:-1000px; top:0; width:256px; height:286px; pointer-events:none; opacity:0; }

/* One fixed toggle stays aligned left of the expanded actions and collapsed name. */
.place-collapse { position:absolute; left:36rpx; bottom:calc(var(--tab-clearance) + 24rpx); width:88rpx; height:88rpx; border-radius:24rpx; display:flex; align-items:center; justify-content:center; z-index:6; }
.place-expand { position:absolute; left:32rpx; bottom:calc(var(--tab-clearance) + 20rpx); max-width:calc(100% - 64rpx); height:96rpx; padding:0 28rpx 0 100rpx; box-sizing:border-box; border-radius:30rpx; z-index:5; display:flex; align-items:center; }
.place-expand-name { min-width:0; flex:1; font-size:28rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.dusk .place-expand { background:rgba(37,38,42,.96); color:#eeeae3; }

/* One native callout owns every visible pin, including the root; coordinates stay real. */
.pin-stack { position:relative; width:88px; }
.pin-stack-toggle { position:absolute; top:0; left:28px; width:32px; height:32px; box-sizing:border-box; border:1px solid rgba(66,85,72,.22); border-radius:50%; background:#fffffb; z-index:20; display:flex; align-items:center; justify-content:center; box-shadow:0 1px 3px rgba(32,47,38,.08); }
.pin-stack-row, .pin-stack-root { position:absolute; left:4px; width:80px; height:89px; }
.pin-stack-root { z-index:10; }
.pin-stack-photo { width:80px; height:89px; }
.pin-stack-pages { position:absolute; top:36px; left:0; width:88px; height:30px; display:flex; color:#34483c; z-index:21; background-color:rgba(255,255,250,.94); border-radius:12px; }
.pin-stack-page-number { width:40px; height:28px; line-height:28px; text-align:center; font-size:12px; }
.pin-stack-page-arrow { width:24px; height:28px; line-height:28px; text-align:center; font-size:22px; }


/* Rebuilt stack: ordinary sibling views receive real taps, not callout snapshots. */
.map-stack-overlay { position:absolute; inset:0; z-index:3; pointer-events:none; }
.map-stack-overlay .pin-stack { position:absolute; pointer-events:none; }
.map-stack-overlay .pin-stack-toggle,
.map-stack-overlay .pin-stack-root,
.map-stack-overlay .pin-stack-pages { pointer-events:auto; }
.map-stack-overlay .pin-stack-row { pointer-events:auto; }
.pin-stack-photo { display:block; }
/* Both card states stay mounted: no wx:if teardown during the transition. */
.place-card { overflow:hidden; transform-origin:bottom left; transition:height 320ms cubic-bezier(.333333,0,.666667,1),border-radius 320ms cubic-bezier(.333333,0,.666667,1),opacity 320ms cubic-bezier(.333333,0,.666667,1); }
.place-card.card-is-collapsed { height:80rpx; border-radius:30rpx; opacity:0; pointer-events:none; }
.place-expand { opacity:0; transform:translateY(24rpx) scale(.96); pointer-events:none; transition:transform 320ms cubic-bezier(.333333,0,.666667,1),opacity 320ms cubic-bezier(.333333,0,.666667,1); }
.place-expand.strip-is-visible { opacity:1; transform:translateY(0) scale(1); pointer-events:auto; }
.quiet .place-card,.quiet .place-expand { transition:none; }

/* SVG geometry replaces font glyphs, with symmetric centering in both states. */
.pin-stack-chevron { display:block; width:23px; height:23px; pointer-events:none; transform:rotate(0deg); transition:transform 320ms cubic-bezier(.333333,0,.666667,1); }
.pin-stack-chevron-open { transform:rotate(180deg); }
.quiet .pin-stack-chevron { transition:none; }

/* Native visual frame and transparent hit frame share the same pixel geometry. */
.native-stack { position:relative; width:88px; }
.native-stack-toggle { position:absolute; top:0; left:28px; width:32px; height:32px; z-index:20; }
.native-stack-row,.native-stack-root { position:absolute; left:4px; width:80px; height:89px; }
.native-stack-root { z-index:10; }
.native-stack-photo { width:80px; height:89px; }
.native-stack-pages { position:absolute; top:36px; left:0; width:88px; height:30px; display:flex; color:#34483c; z-index:21; background-color:#fffffb; border-radius:12px; }
.native-stack-page-arrow { width:24px; height:28px; line-height:28px; text-align:center; font-size:22px; }
.native-stack-page-number { width:40px; height:28px; line-height:28px; text-align:center; font-size:12px; }
.map-stack-overlay .pin-stack-toggle,.map-stack-overlay .pin-stack-pages { background:transparent; border-color:transparent; box-shadow:none; }

/* Menus stay mounted through both transition directions. Native map untouched. */
.map-filter-button { transition:background-color 180ms ease; }
.filter-check { display:block;opacity:0;transform:scale(.75);transition:opacity 180ms ease,transform 180ms ease; }
.filter-check.check-visible { opacity:1;transform:scale(1); }
.pending-close { display:flex;align-items:center;justify-content:center; }
.quiet .filter-check,.quiet .map-filter-button { transition:none; }

.native-stack-page-arrow { width:24px;height:24px;margin-top:2px; }

/* Fallback hit geometry. Live per-drawer metrics use >=44px width and 40px height;
   the vertical target ends at y=36 where paging starts, without moving the glyph. */
.map-stack-overlay .pin-stack-toggle { left:22px; width:44px; }
.map-stack-overlay .pin-stack-page-arrow { width:44px; flex-shrink:0; margin-left:-10px; margin-right:-10px; }

/* Ordinary Map controls: larger targets, existing glyphs and small active disc. */
.map-clear { width:88rpx; height:88rpx; flex-shrink:0; align-items:center; }
.map-filter-button { width:88rpx; height:88rpx; flex-shrink:0; position:relative; }
.map-filter-button.filter-active { background:transparent; }
.map-filter-button.filter-active::before { content:""; position:absolute; width:56rpx; height:62rpx; border-radius:50%; background:#d5dccf; }
.dusk .map-filter-button.filter-active::before { background:#5a4d3d; }
.map-filter-button s-icon { position:relative; }
.pending-close { min-width:88rpx; min-height:88rpx; box-sizing:border-box; justify-content:center; }
.place-collapse-visual { width:56rpx; height:56rpx; box-sizing:border-box; border-radius:24rpx; display:flex; align-items:center; justify-content:center; transition:transform 320ms cubic-bezier(.333333,0,.666667,1); }
.place-collapse.is-collapsed .place-collapse-visual { transform:rotate(180deg); }
.dusk .place-collapse-visual { background:rgba(37,38,42,.96); color:#eeeae3; }
.quiet .place-collapse-visual { transition:none; }
/* Search uses the exact bottom-card material tokens; dimensions and Map geometry stay fixed. */
.map-screen .map-search.content-card {
  background:var(--content-card-bg);
  border-color:var(--content-card-border);
  box-shadow:var(--content-card-shadow);
  -webkit-backdrop-filter:blur(var(--content-card-blur));
  backdrop-filter:blur(var(--content-card-blur));
}
