<s-identity-gate wx:if="{{locked}}"/>
<view wx:else class="screen secondary-screen account {{dusk ? 'dusk' : ''}} {{locale === 'zh-CN' ? 'locale-zh' : ''}}">
  <text class="title">{{labels.title}}</text>
  <view class="account-meta">
    <text class="account-partition">{{labels.partition}}：{{shortId}}</text>
    <text class="hint">{{labels.intro}}</text>
  </view>
  <view class="card account-primary-card">
    <text class="heading">{{locale === 'zh-CN' ? '当前账号备份' : 'Current account backup'}}</text>
    <button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="exportCurrent">{{labels.backup}}</button>
  </view>
  <view class="card account-legacy-card">
    <text class="heading">{{locale === 'zh-CN' ? '旧数据核验与迁移' : 'Legacy verification & migration'}}</text>
    <button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="copyProfile">{{labels.profile}}</button>
    <button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="inspect" disabled="{{busy}}">{{labels.inspect}}</button>
    <button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="exportRaw">{{labels.raw}}</button>
    <button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="copyMemories">{{labels.memories}}</button>
    <button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="copyDraft">{{labels.draft}}</button>
  </view>
  <text wx:if="{{message}}" class="notice" selectable>{{message}}</text>
  <view class="row" wx:for="{{results}}" wx:key="index"><text>{{item.kind}} · {{item.status}}</text></view>
</view>
