<s-identity-gate wx:if="{{locked}}" />
<view wx:else class="screen secondary-screen tools {{dusk ? 'dusk' : ''}} {{locale === 'zh-CN' ? 'locale-zh' : ''}}">
  <view>
    <text class="eyebrow">SAVOR / PRIVATE WORKSPACE</text>
    <text class="title">{{labels.title}}</text><text class="hint">{{labels.intro}}</text>
    <view class="workspace-summary">
      <text wx:if="{{busy}}" class="heading">{{labels.loadingStatus}}</text>
      <text wx:elif="{{pending}}" class="heading">{{labels.pending}}</text>
      <text wx:elif="{{message && message !== labels.ready && message !== labels.done}}" class="heading">{{labels.reviewStatus}}</text>
      <text wx:elif="{{message === labels.ready || message === labels.done}}" class="heading">{{labels.loadedStatus}}</text>
      <text class="hint">{{labels.chooseTool}}</text>
    </view>
    <text class="notice" wx:if="{{message}}" selectable>{{message}}</text>
    <view wx:if="{{pending}}" class="card"><text class="hint">{{labels.pending}}</text><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" disabled="{{busy}}" bindtap="retry">{{labels.retry}}</button><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" disabled="{{busy}}" bindtap="preserve">{{labels.preserve}}</button></view>
    <view class="card"><text class="heading">{{labels.backup}}</text><text class="hint">{{labels.backupHint}}</text><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" disabled="{{busy}}" bindtap="readCloud">{{labels.readCloud}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-primary {{(busy || pending) ? 'ui-disabled' : ''}}" disabled="{{busy || pending}}" bindtap="backup">{{labels.createBackup}}</button><button class="{{(busy || pending) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" disabled="{{busy || pending}}" bindtap="importFile">{{labels.importFile}}</button></view>
    <view class="card"><text class="heading">{{labels.tasks}}</text><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" loading="{{busy}}" disabled="{{busy}}" bindtap="refresh">{{labels.refresh}}</button><view wx:if="{{!busy && !message && !tasks.length}}" class="ui-empty">{{uiText.emptyTasks}}</view><view wx:for="{{tasks}}" wx:key="id" class="row"><text>{{labels.states[item.state] || labels.unknownState}}</text><text class="technical" selectable>{{item.kind}} · {{item.state}} · {{item.count}} · {{item.id}}</text><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" size="mini" disabled="{{busy}}" data-id="{{item.id}}" bindtap="selectTask">{{labels.preview}}</button></view><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" wx:if="{{taskCursor}}" disabled="{{busy}}" bindtap="nextTasks">{{labels.moreTasks}}</button></view>
    <view wx:if="{{task}}" class="card"><text class="heading">{{labels.states[task.state] || labels.unknownState}}</text><text class="technical">{{task.kind}} · {{task.state}}</text><text class="hint">{{task.count}} records · {{task.uploaded}} / {{task.chunkCount}} chunks · {{task.cursor}} committed · {{task.created}} created · {{task.skipped}} skipped · {{task.photoRefsRemoved}} photo refs removed on restore</text><view wx:for="{{preview}}" wx:key="key" class="row">{{item.date}} · {{item.restaurantName}}</view><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" wx:if="{{task.state === 'ready'}}" disabled="{{busy}}" bindtap="restore">{{labels.restore}}</button><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" wx:if="{{task.state === 'running'}}" disabled="{{busy}}" bindtap="resume">{{labels.resume}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-danger {{(busy) ? 'ui-disabled' : ''}}" wx:if="{{task.state !== 'done' && task.state !== 'cancelled'}}" disabled="{{busy}}" bindtap="cancel">{{labels.cancel}}</button><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" wx:if="{{task.uploaded === task.chunkCount}}" disabled="{{busy}}" bindtap="exportTask">{{labels.export}}</button></view>
    <view class="card"><text class="heading">{{labels.profile}}</text><text class="hint">{{labels.profileHint}}</text><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" disabled="{{busy}}" bindtap="pull">{{labels.pull}}</button><view wx:if="{{remote}}" class="row"><text>{{labels.revision}} {{remote.revision}}</text><text>{{remote.name}} · {{remote.bio}}</text><text selectable>{{remote.preferences}}</text><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" disabled="{{busy}}" bindtap="apply">{{labels.apply}}</button></view><button class="{{(busy || pending) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" disabled="{{busy || pending}}" bindtap="avatar">{{labels.avatar}}</button><text wx:if="{{avatarSelected}}" class="hint">{{labels.selected}}</text><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-primary {{(busy || pending || !profileRead) ? 'ui-disabled' : ''}}" disabled="{{busy || pending || !profileRead}}" bindtap="push">{{labels.push}}</button><text class="hint">{{labels.grantHint}}</text><button class="{{(busy || pending || !remote) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" wx:if="{{config.space}}" disabled="{{busy || pending || !remote}}" bindtap="grant">{{labels.grant}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-danger {{(busy || pending || !remote) ? 'ui-disabled' : ''}}" disabled="{{busy || pending || !remote}}" bindtap="revoke">{{labels.revoke}}</button><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" wx:if="{{config.space}}" disabled="{{busy}}" bindtap="partner">{{labels.partner}}</button><view wx:if="{{partnerProfile}}" class="row"><text>{{partnerProfile.name}}</text><text>{{partnerProfile.bio}}</text></view></view>
    <view class="card"><text class="heading">{{labels.reminder}}</text><text class="hint">{{labels.reminderHint}}</text><text wx:if="{{!config.reminderReady}}" class="notice">{{config.remindersDisabled ? labels.remindersOff : labels.notReady}}</text><block wx:if="{{config.reminderReady}}"><input class="{{focusedField === 'reminderTitle' ? 'is-focused' : ''}}" placeholder-class="secondary-placeholder" data-focus-key="reminderTitle" bindfocus="onFieldFocus" bindblur="onFieldBlur" value="{{reminderTitle}}" data-key="reminderTitle" bindinput="input" maxlength="20" placeholder="{{labels.reminderTitle}}" aria-label="{{labels.reminderTitle}}" /><picker mode="date" value="{{date}}" data-key="date" bindchange="input"><view class="field">{{date}}</view></picker><picker mode="time" value="{{time}}" data-key="time" bindchange="input"><view class="field">{{time}}</view></picker><button class="{{(busy || pending || !config.reminderReady) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" disabled="{{busy || pending || !config.reminderReady}}" bindtap="schedule">{{labels.schedule}}</button></block></view>
    <view class="card"><text class="heading">{{labels.feedback}}</text><text class="hint">{{labels.feedbackHint}}</text><text class="notice">{{labels.cloudOnly}}</text><textarea class="{{focusedField === 'feedbackMessage' ? 'is-focused' : ''}}" placeholder-class="secondary-placeholder" data-focus-key="feedbackMessage" bindfocus="onFieldFocus" bindblur="onFieldBlur" value="{{feedbackMessage}}" data-key="feedbackMessage" bindinput="input" maxlength="2000" placeholder="{{labels.message}}" aria-label="{{labels.message}}" /><input class="{{focusedField === 'contact' ? 'is-focused' : ''}}" placeholder-class="secondary-placeholder" data-focus-key="contact" bindfocus="onFieldFocus" bindblur="onFieldBlur" value="{{contact}}" data-key="contact" bindinput="input" maxlength="180" placeholder="{{labels.contact}}" aria-label="{{labels.contact}}" /><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-primary {{(busy || pending) ? 'ui-disabled' : ''}}" disabled="{{busy || pending}}" bindtap="send">{{labels.send}}</button></view>
    <view class="card"><text class="heading">{{labels.jobs}}</text><view wx:if="{{!busy && !message && !jobs.length}}" class="ui-empty">{{uiText.emptyJobs}}</view><view wx:for="{{jobs}}" wx:key="id" class="row"><text>{{item.state === 'stored' ? labels.stored : (labels.states[item.state] || labels.unknownState)}}</text><text class="technical" selectable>{{item.type}} · {{item.state}} · {{item.code}} · {{item.id}}</text><text>{{item.title || item.message}}</text><text wx:if="{{item.type === 'reminder'}}">{{item.dueText}}</text><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-danger {{(busy) ? 'ui-disabled' : ''}}" wx:if="{{item.state === 'queued' || item.state === 'blocked_config'}}" size="mini" data-id="{{item.id}}" disabled="{{busy}}" bindtap="cancelJob">{{labels.jobCancel}}</button><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" wx:if="{{item.type === 'feedback' && config.feedbackMode !== 'cloud_only' && item.deliveryMode !== 'cloud_only' && (item.state === 'failed' || item.state === 'blocked_config' || item.state === 'uncertain')}}" size="mini" data-id="{{item.id}}" disabled="{{busy}}" bindtap="retryJob">{{labels.jobRetry}}</button></view><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" wx:if="{{jobCursor}}" disabled="{{busy}}" bindtap="nextJobs">{{labels.moreJobs}}</button><text class="technical">{{labels.statusHint}}</text></view>
    <button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="reports">{{labels.reports}}</button>
  </view>
</view>
