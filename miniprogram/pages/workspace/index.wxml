<view class="tools {{dusk ? 'dusk' : ''}}">
  <s-identity-gate />
  <view wx:if="{{!locked}}">
    <text class="eyebrow">SAVOR / PRIVATE WORKSPACE</text>
    <text class="title">{{labels.title}}</text><text class="hint">{{labels.intro}}</text>
    <text class="notice" wx:if="{{message}}" selectable>{{message}}</text>
    <view wx:if="{{pending}}" class="card"><text class="hint">{{labels.pending}}</text><button disabled="{{busy}}" bindtap="retry">{{labels.retry}}</button><button disabled="{{busy}}" bindtap="preserve">{{labels.preserve}}</button></view>
    <view class="card"><text class="heading">{{labels.backup}}</text><text class="hint">{{labels.backupHint}}</text><button disabled="{{busy}}" bindtap="readCloud">{{labels.readCloud}}</button><button disabled="{{busy || pending}}" bindtap="backup">{{labels.createBackup}}</button><button disabled="{{busy || pending}}" bindtap="importFile">{{labels.importFile}}</button></view>
    <view class="card"><text class="heading">{{labels.tasks}}</text><button disabled="{{busy}}" bindtap="refresh">{{labels.refresh}}</button><view wx:for="{{tasks}}" wx:key="id" class="row"><text selectable>{{item.id}}</text><text>{{item.kind}} · {{item.state}} · {{item.count}}</text><button size="mini" disabled="{{busy}}" data-id="{{item.id}}" bindtap="selectTask">{{labels.preview}}</button></view><button wx:if="{{taskCursor}}" disabled="{{busy}}" bindtap="nextTasks">{{labels.moreTasks}}</button></view>
    <view wx:if="{{task}}" class="card"><text class="heading">{{task.kind}} · {{task.state}}</text><text class="hint">{{task.count}} records · {{task.uploaded}} / {{task.chunkCount}} chunks · {{task.cursor}} committed · {{task.created}} created · {{task.skipped}} skipped · {{task.photoRefsRemoved}} photo refs removed on restore</text><view wx:for="{{preview}}" wx:key="key" class="row">{{item.date}} · {{item.restaurantName}}</view><button wx:if="{{task.state === 'ready'}}" disabled="{{busy}}" bindtap="restore">{{labels.restore}}</button><button wx:if="{{task.state === 'running'}}" disabled="{{busy}}" bindtap="resume">{{labels.resume}}</button><button wx:if="{{task.state !== 'done' && task.state !== 'cancelled'}}" disabled="{{busy}}" bindtap="cancel">{{labels.cancel}}</button><button wx:if="{{task.uploaded === task.chunkCount}}" disabled="{{busy}}" bindtap="exportTask">{{labels.export}}</button></view>
    <view class="card"><text class="heading">{{labels.profile}}</text><text class="hint">{{labels.profileHint}}</text><button disabled="{{busy}}" bindtap="pull">{{labels.pull}}</button><view wx:if="{{remote}}" class="row"><text>{{labels.revision}} {{remote.revision}}</text><text>{{remote.name}} · {{remote.bio}}</text><text selectable>{{remote.preferences}}</text><button disabled="{{busy}}" bindtap="apply">{{labels.apply}}</button></view><button disabled="{{busy || pending}}" bindtap="avatar">{{labels.avatar}}</button><text wx:if="{{avatarSelected}}" class="hint">{{labels.selected}}</text><button disabled="{{busy || pending || !profileRead}}" bindtap="push">{{labels.push}}</button><text class="hint">{{labels.grantHint}}</text><button wx:if="{{config.space}}" disabled="{{busy || pending || !remote}}" bindtap="grant">{{labels.grant}}</button><button disabled="{{busy || pending || !remote}}" bindtap="revoke">{{labels.revoke}}</button><button wx:if="{{config.space}}" disabled="{{busy}}" bindtap="partner">{{labels.partner}}</button><view wx:if="{{partnerProfile}}" class="row"><text>{{partnerProfile.name}}</text><text>{{partnerProfile.bio}}</text></view></view>
    <view class="card"><text class="heading">{{labels.reminder}}</text><text class="hint">{{labels.reminderHint}}</text><text wx:if="{{!config.reminderReady}}" class="notice">{{labels.notReady}}</text><input value="{{reminderTitle}}" data-key="reminderTitle" bindinput="input" maxlength="20" placeholder="{{labels.reminderTitle}}" aria-label="{{labels.reminderTitle}}" /><picker mode="date" value="{{date}}" data-key="date" bindchange="input"><view class="field">{{date}}</view></picker><picker mode="time" value="{{time}}" data-key="time" bindchange="input"><view class="field">{{time}}</view></picker><button disabled="{{busy || pending || !config.reminderReady}}" bindtap="schedule">{{labels.schedule}}</button></view>
    <view class="card"><text class="heading">{{labels.feedback}}</text><text class="hint">{{labels.feedbackHint}}</text><text wx:if="{{!config.feedbackReady}}" class="notice">{{labels.notReady}}</text><textarea value="{{feedbackMessage}}" data-key="feedbackMessage" bindinput="input" maxlength="2000" placeholder="{{labels.message}}" aria-label="{{labels.message}}" /><input value="{{contact}}" data-key="contact" bindinput="input" maxlength="180" placeholder="{{labels.contact}}" aria-label="{{labels.contact}}" /><button disabled="{{busy || pending}}" bindtap="send">{{labels.send}}</button></view>
    <view class="card"><text class="heading">{{labels.jobs}}</text><text class="hint">{{labels.statusHint}}</text><view wx:for="{{jobs}}" wx:key="id" class="row"><text selectable>{{item.id}}</text><text>{{item.type}} · {{item.state}} · {{item.code}}</text><text>{{item.title || item.message}}</text><text wx:if="{{item.type === 'reminder'}}">{{item.dueText}}</text><button wx:if="{{item.state === 'queued' || item.state === 'blocked_config'}}" size="mini" data-id="{{item.id}}" disabled="{{busy}}" bindtap="cancelJob">{{labels.jobCancel}}</button><button wx:if="{{item.type === 'feedback' && (item.state === 'failed' || item.state === 'blocked_config' || item.state === 'uncertain')}}" size="mini" data-id="{{item.id}}" disabled="{{busy}}" bindtap="retryJob">{{labels.jobRetry}}</button></view><button wx:if="{{jobCursor}}" disabled="{{busy}}" bindtap="nextJobs">{{labels.moreJobs}}</button></view>
    <button bindtap="reports">{{labels.reports}}</button>
  </view>
</view>
