page{background:#eeece9}.tools{min-height:100vh;padding:40rpx 32rpx 100rpx;box-sizing:border-box;background:#eeece9;color:#283126}.tools.dusk{background:#192019;color:#e9ecdf}.eyebrow,.title,.heading,.hint,.notice,.row text{display:block}.eyebrow{font-size:20rpx;letter-spacing:4rpx;opacity:.65}.title{font-size:48rpx;line-height:1.5;margin:18rpx 0}.heading{font-size:32rpx;margin-bottom:18rpx}.hint{font-size:25rpx;line-height:1.8;opacity:.76}.notice{padding:20rpx 0;font-size:25rpx;line-height:1.7;overflow-wrap:anywhere}.card{padding:28rpx;margin:26rpx 0;background:rgba(255,255,255,.38);border:1rpx solid rgba(90,100,75,.16);border-radius:24rpx}.dusk .card{background:rgba(255,255,255,.04)}button{min-height:88rpx;font-size:25rpx;margin-top:20rpx;background:#dde3d4;color:#263320;border-radius:14rpx;white-space:normal;line-height:1.6;padding:18rpx 16rpx}button[disabled]{opacity:.48}input,textarea,.field{display:block;box-sizing:border-box;width:100%;background:rgba(130,145,112,.09);border:1rpx solid rgba(90,100,75,.2);border-radius:12rpx;padding:18rpx;font-size:27rpx;line-height:1.6;margin-top:20rpx;color:inherit}input{min-height:90rpx;height:auto}textarea{height:240rpx}.row{padding:20rpx 0;border-bottom:1rpx solid rgba(90,100,75,.18);font-size:24rpx;line-height:1.8;overflow-wrap:anywhere}
