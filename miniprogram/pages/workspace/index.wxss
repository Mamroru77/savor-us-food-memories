@import "../../styles/secondary.wxss";

.tools .title { display:none; }
.workspace-summary {
  padding: 20rpx 24rpx;
  margin: 20rpx 0 8rpx;
  border-radius: 24rpx;
  background: rgba(112, 121, 101, 0.08);
  border: 1rpx solid var(--glass-border);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.dusk .workspace-summary { background: rgba(238, 234, 227, 0.06); }

