.space-scroll{height:100vh;background:#eeece9;color:#343a32}.space-page{padding:32rpx;display:flex;flex-direction:column;gap:24rpx;font-size:28rpx;line-height:1.65}.title{font-size:40rpx;font-weight:600}.heading{font-size:32rpx;font-weight:600}.card{display:flex;flex-direction:column;gap:20rpx;padding:28rpx;background:#fff9;border-radius:28rpx;margin-bottom:24rpx}.actions{display:flex;flex-wrap:wrap;gap:12rpx}button{font-size:26rpx}input,textarea{background:#fff;padding:18rpx;border-radius:16rpx;width:auto}textarea{height:130rpx}

.shared-media-photo{width:100%;height:320rpx;border-radius:20rpx;background:#deded8}
