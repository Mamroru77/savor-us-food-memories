<s-identity-gate wx:if="{{locked}}"/>
<scroll-view wx:else scroll-y class="space-scroll {{dusk ? 'dusk' : ''}}"><view class="screen secondary-screen space-page {{dusk ? 'dusk' : ''}} {{locale === 'zh-CN' ? 'locale-zh' : ''}}">
 <text class="title">{{labels.title}}</text><text class="hint">{{labels.intro}}</text>
 <button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" loading="{{busy}}" bindtap="refresh" disabled="{{busy}}">{{busy ? labels.loading : labels.refresh}}</button>
 <text wx:if="{{message}}" class="notice" selectable>{{message}}</text>
 <view wx:if="{{pending}}" class="card"><text>{{labels.pending}}</text><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="retry" disabled="{{busy}}">{{labels.retry}}</button></view>
 <view wx:if="{{mediaPending}}" class="card"><text>{{labels.photoPending}}</text><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="retryMedia" disabled="{{busy}}">{{labels.retryPhoto}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-danger {{(busy) ? 'ui-disabled' : ''}}" bindtap="cancelMedia" disabled="{{busy}}">{{labels.cancelPhoto}}</button></view>
 <view wx:if="{{!space}}" class="card">
  <text>{{labels.unbound}}</text><button class="{{(busy || pending) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="createInvite" disabled="{{busy || pending}}">{{labels.create}}</button>
  <view wx:if="{{invitation}}"><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="copyInvite">{{labels.copy}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-danger {{(busy || pending) ? 'ui-disabled' : ''}}" bindtap="revokeInvite" disabled="{{busy || pending}}">{{labels.revoke}}</button></view>
  <input class="{{focusedField === 'onInvite' ? 'is-focused' : ''}}" placeholder-class="secondary-placeholder" data-focus-key="onInvite" bindfocus="onFieldFocus" bindblur="onFieldBlur" value="{{inviteText}}" bindinput="onInvite" placeholder="{{labels.placeholder}}" maxlength="100"/>
  <button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-primary {{(busy || pending) ? 'ui-disabled' : ''}}" bindtap="acceptInvite" disabled="{{busy || pending}}">{{labels.join}}</button>
 </view>
 <view wx:else>
  <button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-danger {{(busy || pending) ? 'ui-disabled' : ''}}" bindtap="leave" disabled="{{busy || pending}}">{{labels.leave}}</button>
  <view class="card"><text class="heading">{{labels.wishlist}}</text><input class="{{focusedField === 'onTitle' ? 'is-focused' : ''}}" placeholder-class="secondary-placeholder" data-focus-key="onTitle" bindfocus="onFieldFocus" bindblur="onFieldBlur" value="{{wishTitle}}" bindinput="onTitle" placeholder="{{labels.wishTitle}}" maxlength="80"/><textarea class="{{focusedField === 'onNote' ? 'is-focused' : ''}}" placeholder-class="secondary-placeholder" data-focus-key="onNote" bindfocus="onFieldFocus" bindblur="onFieldBlur" value="{{wishNote}}" bindinput="onNote" placeholder="{{labels.wishNote}}" maxlength="500"/><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-primary {{(busy || pending) ? 'ui-disabled' : ''}}" bindtap="addWish" disabled="{{busy || pending}}">{{labels.add}}</button></view>
  <view wx:if="{{!busy && !message && !wishes.length}}" class="ui-empty">{{uiText.emptyWishes}}</view>
  <view wx:for="{{wishes}}" wx:key="_id" class="card">
   <text class="heading">{{item.title}}</text><text>{{item.note}}</text><text>{{item.status}} · {{item.preferenceLabel}}</text>
   <view class="actions"><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" size="mini" data-id="{{item._id}}" data-value="want" bindtap="preference">{{labels.want}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" size="mini" data-id="{{item._id}}" data-value="maybe" bindtap="preference">{{labels.maybe}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" size="mini" data-id="{{item._id}}" data-value="no" bindtap="preference">{{labels.no}}</button></view>
   <view class="actions"><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" size="mini" data-id="{{item._id}}" data-value="{{item.status === 'eaten' ? 'open' : 'eaten'}}" bindtap="wishStatus">{{item.status === 'eaten' ? labels.reopen : labels.eaten}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" size="mini" data-id="{{item._id}}" bindtap="toDraft">{{labels.draft}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-danger" wx:if="{{item.creatorUserId === userId}}" size="mini" data-id="{{item._id}}" data-value="deleted" bindtap="wishStatus">{{labels.remove}}</button></view>
  </view>
  <view class="card"><text class="heading">{{labels.meals}}</text><text>{{labels.privacy}}</text><button class="{{(busy || pending) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" bindtap="publishMeal" disabled="{{busy || pending}}">{{labels.publish}}</button></view>
  <view wx:for="{{publishCandidates}}" wx:key="id" class="card"><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" data-id="{{item.cloudId}}" bindtap="publishCandidate">{{item.restaurant}} · {{item.date}}</button></view>
  <view wx:if="{{!busy && !message && !meals.length}}" class="ui-empty">{{uiText.emptyMeals}}</view>
  <view wx:for="{{meals}}" wx:key="_id" class="card"><text class="heading">{{item.payload.restaurantName}}</text><text>{{item.payload.date}} · {{item.payload.city}}</text><text>{{item.payload.note}}</text><text>{{item.ratingLabel}}</text><view class="actions"><button class="{{(busy) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" size="mini" data-id="{{item._id}}" bindtap="viewMedia" disabled="{{busy}}">{{labels.viewPhotos}}</button><button class="{{(busy || mediaPending) ? 'ui-disabled' : ''}}" hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" wx:if="{{item.ownerUserId === userId}}" size="mini" data-id="{{item._id}}" bindtap="addMedia" disabled="{{busy || mediaPending}}">{{labels.addPhoto}}</button></view><view wx:for="{{item.sharedImages}}" wx:for-item="photo" wx:key="id"><image wx:if="{{!photo.failed}}" class="shared-media-photo" src="{{photo.src}}" mode="aspectFit" binderror="onSharedImageError" data-id="{{photo.id}}"/><text wx:else>{{labels.photoUnavailable}}</text><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-danger {{(busy) ? 'ui-disabled' : ''}}" wx:if="{{item.ownerUserId === userId}}" size="mini" data-id="{{photo.id}}" bindtap="withdrawMedia" disabled="{{busy}}">{{labels.removePhoto}}</button></view><view class="actions"><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" size="mini" data-id="{{item._id}}" bindtap="rateMeal">{{labels.rate}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" size="mini" data-id="{{item._id}}" data-value="0" bindtap="unrateMeal">{{labels.unrate}}</button><button hover-class="ui-pressed" hover-start-time="0" hover-stay-time="100" class="ui-danger" wx:if="{{item.ownerUserId === userId}}" size="mini" data-id="{{item._id}}" bindtap="retractMeal">{{labels.retract}}</button></view></view>
 </view>
</view></scroll-view>
