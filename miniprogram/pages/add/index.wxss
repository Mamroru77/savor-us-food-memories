/* Add — port of screens.css “Add a memory” (×2.5). */
.add-screen {
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: calc(var(--tab-clearance) + 16rpx);
}

.add-heading { display: flex; gap: 17rpx; align-items: flex-start; margin-left: -12rpx; }
.close-add {
  width: 58rpx;
  height: 62rpx;
  margin-top: 5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-heading-copy { display: flex; flex-direction: column; }
.add-title {
  font-family: var(--serif);
  font-size: 51rpx;
  line-height: 62rpx;
  letter-spacing: -0.5rpx;
}
.add-subtitle { font-size: 26rpx; margin-top: 2rpx; color: var(--muted, #565752); white-space: nowrap; }

.photo-editor-row {
  height: 430rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 50rpx 0 38rpx;
}
.main-photo-wrap {
  width: 445rpx;
  height: 430rpx;
  flex: 0 0 445rpx;
  position: relative;
  border-radius: 42rpx;
  overflow: hidden;
}
.main-memory-photo { width: 100%; height: 100%; }
.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  width: 100%;
  height: 100%;
  border: 2rpx dashed rgba(255, 255, 255, 0.9);
  border-radius: 42rpx;
  color: var(--muted, #565752);
  font-size: 25rpx;
  background: rgba(255, 255, 255, 0.17);
  box-sizing: border-box;
}
.edit-photo {
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  height: 60rpx;
  min-width: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 23rpx;
  border-radius: 37rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  background: rgba(249, 248, 245, 0.77);
  color: var(--ink, #33332f);
  box-sizing: border-box;
}
.photo-uploading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(247, 245, 240, 0.65);
}
.more-photos-wrap { position: relative; }
.add-photo {
  height: 320rpx;
  width: 175rpx;
  border: 3rpx dashed rgba(255, 255, 255, 0.93);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}
.add-photo > image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.6; }
.add-photo-copy {
  display: flex;
  flex-direction: column;
  gap: 17rpx;
  align-items: center;
  font-size: 24rpx;
  color: var(--muted, #565752);
  position: relative;
  z-index: 1;
}
.add-photo.has-photo .add-photo-copy { color: #ffffff; text-shadow: 0 2rpx 10rpx #555; }
.remove-extra {
  position: absolute;
  width: 50rpx;
  height: 50rpx;
  top: -15rpx;
  right: -12rpx;
  border-radius: 50%;
  background: #f4f2ed;
  z-index: 2;
  box-shadow: 0 5rpx 12rpx rgba(0, 0, 0, 0.13);
  display: flex;
  align-items: center;
  justify-content: center;
}

.restaurant-field { margin-top: 8rpx; }
.input-wrap { position: relative; }
.input-wrap .form-input { padding-right: 72rpx; }
.input-clear {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  width: 65rpx;
  height: 65rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.new-place-location { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; font-size: 22rpx; color: var(--muted, #565752); }
.city-picker {
  height: 58rpx;
  padding: 5rpx 12rpx;
  font-size: 22rpx;
  border-radius: 15rpx;
  background: var(--field);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
}

.notes-field { margin-top: 25rpx; }
.notes-textarea { height: 120rpx; min-height: 120rpx; }

.date-rating-row { display: flex; gap: 32rpx; margin-top: 25rpx; }
.date-rating-row > .form-field { flex: 1; min-width: 0; }
.date-input {
  height: 82rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 27rpx;
  background: var(--field);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  font-size: 26rpx;
  white-space: nowrap;
  box-sizing: border-box;
}
.rating-input {
  height: 82rpx;
  padding: 0 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 27rpx;
  background: var(--field);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.rating-star { width: 50rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; }

.tags-field { position: relative; margin-top: 25rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; min-height: 60rpx; }
.tag {
  height: 60rpx;
  padding: 0 25rpx;
  border-radius: 40rpx;
  background: linear-gradient(150deg, rgba(214, 214, 211, 0.8), rgba(204, 204, 201, 0.55));
  font-size: 25rpx;
  line-height: 55rpx;
  border: 1rpx solid rgba(236, 235, 232, 0.6);
  white-space: nowrap;
  box-sizing: border-box;
}
.dusk .tag { background: rgba(159,159,159, 0.18); border-color: rgba(208,208,208, 0.13); }
.add-tag {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(212, 212, 208, 0.5);
  margin-left: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tag-popover {
  position: absolute;
  bottom: 82rpx;
  left: 0;
  width: 100%;
  padding: 25rpx;
  border-radius: 32rpx;
  background: rgba(248, 247, 243, 0.97);
  z-index: 5;
  box-sizing: border-box;
}
.dusk .tag-popover { background: rgba(68,68,68, 0.97); }
.tag-input-row { display: flex; gap: 12rpx; align-items: center; }
.tag-input { min-height: 72rpx; }
.tag-confirm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(212, 212, 208, 0.4);
}
.suggested-tags { display: flex; gap: 20rpx; flex-wrap: wrap; margin-top: 22rpx; }
.suggested-tag { font-size: 25rpx; color: var(--muted, #565752); text-decoration: underline; text-underline-offset: 8rpx; }
.dusk .suggested-tag { color: #b6b2aa; }

.save-memory { height: 100rpx; margin-top: 38rpx; }

.import-entry { display:flex; justify-content:space-between; align-items:center; padding:22rpx 28rpx; margin:20rpx 0; border-radius:24rpx; font-size:28rpx; }
.import-entry-note { font-size:22rpx; opacity:.6; }
.location-entry { display:flex; align-items:center; gap:16rpx; padding:22rpx 0; font-size:26rpx; }
.location-address { display:block; font-size:22rpx; opacity:.6; margin-top:8rpx; }

/* Match Us/Me: native image defaults must not limit the ambient backdrop. */
.ambient-photo { width: 100vw; height: 100vh; }

.dusk .edit-photo, .dusk .remove-extra { background:rgba(45,45,45,.95); border-color:rgba(221,221,221,.2); }
.dusk .photo-uploading { background:rgba(23,23,23,.78); }
.dusk .tag-popover { background:rgba(31,31,31,.98); }
.dusk .add-photo, .dusk .photo-placeholder { border-color:rgba(219,219,219,.35); background:rgba(212,212,212,.07); }

.photo-strip { height:144rpx; width:100%; margin:20rpx 0 35rpx; white-space:nowrap; }
.photo-strip-inner { display:flex; gap:16rpx; padding:12rpx 0; }
.photo-strip-item { position:relative; flex:0 0 108rpx; height:108rpx; }
.photo-strip-item image { width:108rpx; height:108rpx; border-radius:20rpx; }
.photo-strip-remove { position:absolute; right:0; top:0; width:48rpx; height:48rpx; text-align:center; background:#000a; color:white; border-radius:50%; line-height:48rpx; }
.geo-fields { display:flex; flex-direction:column; gap:20rpx; }

/* Local import controls only; preserve the existing page and card language. */
.import-panel { padding:28rpx; border-radius:24rpx; margin-bottom:28rpx; }
.import-text { width:100%; min-height:220rpx; height:260rpx; box-sizing:border-box; }
.import-action { margin-top:20rpx; border-radius:24rpx; font-size:27rpx; background:rgba(70,70,65,.08); color:inherit; }
.import-cancel { background:transparent; }
.import-candidate { display:flex; flex-direction:column; gap:18rpx; padding-top:24rpx; }
.dusk .import-action { background:rgba(240,236,229,.09); color:#eeeae3; }

.category-type-list { display:flex; flex-wrap:wrap; gap:12rpx; margin:14rpx 0 24rpx; }
.category-type { padding:12rpx 20rpx; border:1rpx solid rgba(100,110,95,.25); border-radius:24rpx; font-size:24rpx; }
.category-type.is-selected { background:#293b31; color:#fffaf0; }
.dusk .category-type.is-selected { background:#d6c8aa; color:#222b24; }
.import-match-list { height:320rpx; }
.import-match { padding:20rpx 0; border-bottom:1rpx solid rgba(120,125,114,.2); font-size:27rpx; }

.import-search-preference { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin:18rpx 0; font-size:26rpx; }

.merchant-page-status, .location-search-section { margin:22rpx 0; padding:20rpx 0; border-top:1rpx solid rgba(130,145,122,.18); }

.photo-strip-remove { display:flex;align-items:center;justify-content:center; }

/* Larger touch targets; retain photo glyphs and header shape sizes. */
.close-add { width:88rpx; height:88rpx; flex-shrink:0; position:relative; background:transparent; margin-left:-15rpx; margin-right:-15rpx; margin-top:-8rpx; }
.close-add::before { content:""; position:absolute; width:58rpx; height:62rpx; border-radius:50%; background:rgba(255,255,255,.25); }
.close-add s-icon { position:relative; }
.add-heading-copy { min-width:0; }
.add-subtitle { white-space:normal; overflow-wrap:break-word; }
.input-wrap .form-input { padding-right:98rpx; }
.input-clear { width:88rpx; height:88rpx; top:0; right:0; }
.date-rating-row { flex-wrap:wrap; }
.date-rating-row > .form-field { flex:1 1 240rpx; }
.date-rating-row > .form-field:last-child { flex-basis:464rpx; }
.rating-star { flex:0 0 88rpx; width:88rpx; height:88rpx; }
.rating-input { flex-wrap:wrap; }
.photo-strip-remove { width:88rpx; height:88rpx; background:transparent; align-items:flex-start; justify-content:flex-end; }
.photo-remove-glyph { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; border-radius:50%; background:#000a; }
.category-type, .suggested-tag { min-height:88rpx; box-sizing:border-box; display:inline-flex; align-items:center; }
.category-type.is-selected { text-decoration:underline; text-underline-offset:8rpx; }


.rating-input { min-height:90rpx; height:auto; }
.date-input { min-height:88rpx; height:auto; padding-top:17rpx; padding-bottom:17rpx; }
.dusk .close-add { background:transparent; }
.dusk .close-add::before { background:rgba(234,234,234,.12); }


.rating-clear, .add-tag, .tag-confirm { min-width:88rpx; min-height:88rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:center; }
.rating-clear { justify-content:flex-start; }
.tag { min-height:88rpx; display:inline-flex; align-items:center; box-sizing:border-box; }

/* Separate preview and delete targets; never consume most of a small photo with deletion hit slop. */
.photo-strip { height:220rpx; }
.photo-strip-item { height:196rpx; }
.photo-strip-remove { top:108rpx; right:10rpx; align-items:center; justify-content:center; }
.remove-extra { width:88rpx; height:88rpx; right:-31rpx; top:-34rpx; background:transparent; box-shadow:none; }
.remove-extra::before { content:""; position:absolute; width:50rpx; height:50rpx; border-radius:50%; background:#f4f2ed; box-shadow:0 5rpx 12rpx rgba(0,0,0,.13); }
.remove-extra s-icon { position:relative; }

.dusk .remove-extra { background:transparent; }
.dusk .remove-extra::before { background:rgba(45,45,45,.95); }
