page{background:#f3f3ec}.lab{min-height:100vh;padding:32rpx;box-sizing:border-box;color:#34483c;background:#f3f3ec}.lab.dark{background:#17191c;color:#eeeae3}.title{display:block;font-size:40rpx;font-weight:600}.note{display:block;font-size:24rpx;line-height:38rpx;opacity:.7;margin:22rpx 0}.stage{border-radius:30rpx;background:#dfe5d655;height:300rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:24rpx}.actions{display:flex;gap:16rpx;margin:20rpx 0}.actions button{flex:1;font-size:24rpx}.pairs{margin:28rpx 0}.pair{display:flex;align-items:center;gap:18rpx;padding:20rpx;border-radius:18rpx;font-size:25rpx}.pair text{flex:1}.pair.selected{background:#9aaf872a}.status,.export{display:block;font-family:monospace;font-size:22rpx;line-height:34rpx;word-break:break-all;padding:20rpx;border-radius:16rpx;background:#9aaf871a;margin:20rpx 0}
