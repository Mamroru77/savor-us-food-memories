<view class="gate {{dusk ? 'dusk' : ''}}"><text class="gate-brand">SAVOR</text><text class="title">{{labels.verify}}</text><text class="gate-copy">{{labels.gate}}</text><button class="gate-button" bindtap="retry" loading="{{busy}}" disabled="{{retryDisabled}}" hover-class="gate-pressed">{{busy ? labels.busy : labels.retry}}</button><text wx:if="{{message}}" class="gate-message">{{message}}</text></view>
