.page-header { position: relative; z-index: 5; box-sizing: border-box; }
.page-header-row { display: flex; align-items: center; padding-left: 35rpx; box-sizing: border-box; }
.page-header-button { width: 64rpx; height: 64rpx; margin: 0 10rpx 0 -14rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255, 255, 255, 0.25); flex-shrink: 0; }
.theme-dusk .page-header-button { background: rgba(225, 229, 214, 0.12); }
.page-header-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.page-header-title { font-family: var(--serif); font-size: 52rpx; line-height: 60rpx; letter-spacing: -0.5rpx; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.page-header-subtitle { font-size: 26rpx; line-height: 36rpx; color: var(--muted); margin-top: 2rpx; letter-spacing: -0.3rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.page-header-right { display: flex; align-items: center; gap: 8rpx; margin-left: 16rpx; flex-shrink: 0; }
