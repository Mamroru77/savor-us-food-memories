/* Savor design system. The web concept is a 300px-wide canvas, so every design px maps to 2.5rpx.
   Tokens live on .page so Pearl / Dusk themes swap in one place. */
page {
  background: #eeece9;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Noto Sans", sans-serif;
  font-size: 27rpx;
  line-height: 1.4;
  color: #1b1c1a;
  -webkit-font-smoothing: antialiased;
}

.page {
  --ink: #1b1c1a;
  --muted: #565752;
  --soft: #858979;
  --glass: rgba(252, 251, 249, 0.45);
  --glass-border: rgba(255, 255, 255, 0.7);
  --glass-strong: rgba(251, 250, 247, 0.86);
  --field: rgba(255, 255, 255, 0.48);
  --field-border: rgba(255, 255, 255, 0.72);
  --line: rgba(52, 53, 52, 0.07);
  --tag-bg: linear-gradient(150deg, rgba(214, 214, 211, 0.8), rgba(204, 204, 201, 0.55));
  --tag-border: rgba(236, 235, 232, 0.6);
  --card-shadow: 0 25rpx 48rpx -28rpx rgba(64, 65, 65, 0.25);
  --serif: "Instrument Serif", "Iowan Old Style", "Palatino", Georgia, "Times New Roman", "Songti SC", "Noto Serif CJK SC", serif;
  --motion: 0.2s;
  --accent: #68765b;
  --danger: #954c38;
  min-height: 100vh;
  box-sizing: border-box;
  color: var(--ink);
  background:
    radial-gradient(ellipse 100% 30% at 14% 7%, rgba(255, 255, 255, 0.42), transparent),
    radial-gradient(ellipse 72% 22% at 76% 50%, rgba(150, 153, 153, 0.23), transparent 100%),
    radial-gradient(ellipse 65% 25% at 31% 75%, rgba(110, 116, 119, 0.19), transparent 100%),
    linear-gradient(143deg, #f0f0ef 0%, #eeece9 42%, #e7e6e3 100%);
}
.page.theme-dusk {
  --ink: #edece5;
  --muted: #bfc3b7;
  --soft: #bac7ab;
  --glass: rgba(66, 72, 62, 0.46);
  --glass-border: rgba(225, 229, 214, 0.19);
  --glass-strong: rgba(70, 82, 63, 0.92);
  --field: rgba(222, 228, 210, 0.085);
  --field-border: rgba(206, 217, 189, 0.14);
  --line: rgba(225, 229, 214, 0.1);
  --tag-bg: rgba(161, 175, 140, 0.18);
  --tag-border: rgba(207, 219, 197, 0.125);
  --card-shadow: 0 25rpx 48rpx -28rpx rgba(20, 24, 18, 0.6);
  --accent: #a9bd8f;
  background: radial-gradient(ellipse 80% 30% at 50% 0%, rgba(152, 155, 140, 0.35), transparent 75%), linear-gradient(145deg, #50564c, #3e463b);
}
.page.quiet { --motion: 0s; }

/* Pressed feedback used by hover-class everywhere. */
.pressed { opacity: 0.68; }
.pressed-scale { transform: scale(0.96); opacity: 0.9; }

.glass {
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--card-shadow), inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(34rpx);
  -webkit-backdrop-filter: blur(34rpx);
}
.icon-button { width: 65rpx; height: 65rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; flex-shrink: 0; transition: background var(--motion); }

/* Typography */
.serif { font-family: var(--serif); font-weight: 400; }
.screen-title { font-family: var(--serif); font-size: 52rpx; line-height: 62rpx; letter-spacing: -0.5rpx; color: var(--ink); }
.screen-subtitle { font-size: 26rpx; line-height: 37rpx; margin-top: 4rpx; color: var(--muted); letter-spacing: -0.3rpx; }
.section-title { font-family: var(--serif); font-size: 32rpx; line-height: 40rpx; margin: 0 28rpx 20rpx; color: var(--ink); }
.stat { display: flex; flex-direction: column; align-items: center; font-size: 25rpx; line-height: 35rpx; color: var(--ink); }
.stat-left { align-items: flex-start; }
.stat-value { font-family: var(--serif); font-size: 67rpx; line-height: 75rpx; letter-spacing: -1.7rpx; }
.stat-label { font-size: 25rpx; line-height: 35rpx; }
.stat-divider { border-left: 1rpx solid var(--line); }

/* Cards & lists */
.list-card { border-radius: 42rpx; padding: 0 30rpx; }
.empty-state { padding: 62rpx 20rpx; text-align: center; font-size: 27rpx; line-height: 45rpx; color: var(--muted); }
.empty-link { display: inline-block; text-decoration: underline; text-underline-offset: 6rpx; margin-top: 22rpx; }

/* Buttons */
.primary-button {
  min-height: 98rpx; display: flex; align-items: center; justify-content: center; gap: 20rpx; box-sizing: border-box;
  border-radius: 60rpx; background: linear-gradient(150deg, #31322f, #181a17); border: 3rpx solid rgba(255, 255, 255, 0.92);
  color: #ffffff; font-size: 29rpx; font-weight: 450; padding: 0 35rpx;
  box-shadow: 0 8rpx 18rpx -8rpx rgba(17, 17, 17, 0.35), inset 0 0 0 2rpx #10120f;
  transition: transform var(--motion), opacity var(--motion);
}
.theme-dusk .primary-button { background: linear-gradient(145deg, #e8eadc, #c3ccb3); color: #303a28; border-color: rgba(234, 240, 218, 0.6); box-shadow: 0 5rpx 18rpx rgba(28, 36, 23, 0.33); }
.primary-button.is-disabled { opacity: 0.6; }
.secondary-button, .danger-button {
  min-height: 85rpx; display: flex; align-items: center; justify-content: center; gap: 17rpx; box-sizing: border-box; border-radius: 28rpx;
  border: 1rpx solid rgba(212, 215, 202, 0.44); background: rgba(229, 231, 221, 0.36); font-size: 25rpx; padding: 0 28rpx; color: var(--ink);
}
.theme-dusk .secondary-button { background: rgba(139, 159, 119, 0.14); border-color: rgba(207, 223, 181, 0.16); }
.danger-button { background: rgba(184, 109, 88, 0.125); border-color: rgba(184, 109, 88, 0.15); color: var(--danger); }
.theme-dusk .danger-button { color: #f0b9a6; }
.full-width { width: 100%; }
.text-link { text-decoration: underline; text-underline-offset: 6rpx; }

/* Forms */
.form-field { display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.field-label { font-size: 25rpx; line-height: 33rpx; font-weight: 550; color: var(--ink); }
.field-input, .field-textarea, .date-input, .select-input {
  box-sizing: border-box; width: 100%; min-height: 83rpx; border: 1rpx solid var(--field-border); background: var(--field);
  border-radius: 28rpx; padding: 0 23rpx; font-size: 27rpx; line-height: 40rpx; color: var(--ink);
}
.field-input { display: flex; align-items: center; height: 83rpx; }
.field-textarea { height: 120rpx; padding: 18rpx 23rpx; line-height: 38rpx; }
.placeholder { color: #93938d; }
.theme-dusk .placeholder { color: #9aa192; }
.date-input, .select-input { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.date-input-text { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.tag {
  height: 60rpx; padding: 0 25rpx; border-radius: 40rpx; font-size: 25rpx; line-height: 56rpx; color: var(--ink);
  background: var(--tag-bg); border: 1rpx solid var(--tag-border); white-space: nowrap;
}

.toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 36rpx; padding: 34rpx 0; border-bottom: 1rpx solid rgba(144, 156, 120, 0.125); }
.toggle-copy { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.toggle-title { font-size: 27rpx; line-height: 37rpx; font-weight: 500; }
.toggle-text { font-size: 23rpx; line-height: 34rpx; color: var(--muted); }
.toggle-track { width: 88rpx; height: 52rpx; border-radius: 40rpx; background: #c5cbbd; padding: 7rpx; box-sizing: border-box; flex-shrink: 0; transition: background var(--motion); }
.toggle-knob { width: 38rpx; height: 38rpx; border-radius: 50%; background: #ffffff; box-shadow: 0 2rpx 6rpx rgba(62, 78, 37, 0.15); transition: transform var(--motion); }
.toggle-track.is-on { background: #68765b; }
.theme-dusk .toggle-track { background: #69765d; }
.theme-dusk .toggle-track.is-on { background: #a9bd8f; }
.toggle-track.is-on .toggle-knob { transform: translateX(36rpx); }

.helper-note { font-size: 23rpx; line-height: 37rpx; color: var(--soft); }
.form-error { margin: 22rpx 0; padding: 20rpx 22rpx; border-radius: 20rpx; font-size: 25rpx; line-height: 37rpx; color: #994d3d; background: rgba(245, 218, 208, 0.5); }
.theme-dusk .form-error { color: #f1c1b0; background: rgba(184, 109, 88, 0.22); }
.rating { display: flex; gap: 10rpx; align-items: center; }
.avatar { border-radius: 50%; border: 4rpx solid rgba(255, 255, 255, 0.9); box-shadow: 0 4rpx 8rpx rgba(85, 85, 85, 0.07); background: #e3e2de; }
.text-dot { display: inline-block; width: 4rpx; height: 4rpx; border-radius: 50%; background: currentColor; vertical-align: middle; margin: 0 10rpx; }
.spin { animation: savor-spin 0.9s linear infinite; }
@keyframes savor-spin { to { transform: rotate(360deg); } }

/* Space for the fixed custom tab bar (170rpx) plus the home indicator. */
.tab-spacer { height: calc(200rpx + env(safe-area-inset-bottom)); }

/* Secondary pages (memory, library, sheet) share a panel-like body. */
.sheet-body { padding: 8rpx 40rpx 60rpx; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.sheet-action { margin-top: 40rpx; }
.sheet-note { margin-top: 28rpx; }
.settings-form { display: flex; flex-direction: column; gap: 35rpx; }
.settings-form .field-label { font-size: 27rpx; }
.settings-form .field-input, .settings-form .date-input, .settings-form .select-input { min-height: 92rpx; height: 92rpx; }
