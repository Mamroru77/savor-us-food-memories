<view class="page {{dusk ? 'theme-dusk' : ''}} {{quiet ? 'quiet' : ''}}">
  <page-header title="{{title}}" subtitle="{{subtitle}}" back="{{true}}" ink="{{ink}}"/>
  <view class="sheet-body">

    <!-- Profile -->
    <view wx:if="{{type === 'profile'}}" class="settings-form">
      <view class="edit-avatar" hover-class="pressed" bindtap="pickAvatar" aria-role="button" aria-label="Change profile photo">
        <image class="edit-avatar-photo" src="{{form.avatar}}" mode="aspectFill"/>
        <view class="edit-avatar-badge"><s-icon name="camera" size="15" color="#1b1c1a"/></view>
      </view>
      <view class="form-field"><view class="field-label">Your name</view><input class="field-input" value="{{form.name}}" data-key="name" bindinput="onForm" placeholder="Jamie Lin" placeholder-class="placeholder" maxlength="32"/></view>
      <view class="form-field"><view class="field-label">A little about you</view><input class="field-input" value="{{form.bio}}" data-key="bio" bindinput="onForm" placeholder="Where next?" placeholder-class="placeholder" maxlength="55"/></view>
      <view wx:if="{{error}}" class="form-error" aria-role="alert">{{error}}</view>
      <view class="primary-button" hover-class="pressed-scale" bindtap="saveProfile" aria-role="button"><s-icon name="check" size="15" color="{{buttonInk}}"/><text>Save profile</text></view>
    </view>

    <!-- Together -->
    <view wx:elif="{{type === 'together'}}" class="settings-form">
      <view class="sheet-couple">
        <image class="sheet-couple-photo" src="{{profile.avatar}}" mode="aspectFill"/>
        <s-icon name="heart" size="23" color="#df816b" fill="current" stroke="1.3"/>
        <image class="sheet-couple-photo" src="{{alexPhoto}}" mode="aspectFill"/>
      </view>
      <view class="together-message">The best things are better shared.</view>
      <view class="form-field"><view class="field-label">Your person</view><input class="field-input" value="{{form.partner}}" data-key="partner" bindinput="onForm" maxlength="30" placeholder="Alex" placeholder-class="placeholder"/></view>
      <view class="form-field"><view class="field-label">Our story began</view>
        <picker mode="date" value="{{form.togetherSince}}" end="{{today}}" bindchange="onSince"><view class="date-input"><text class="date-input-text">{{sinceLabel}}</text><s-icon name="calendar-days" size="13" color="{{ink}}" stroke="1.4"/></view></picker>
      </view>
      <view class="helper-note">Your shared space lives in this local diary. Memories you share appear in Us.</view>
      <view wx:if="{{error}}" class="form-error" aria-role="alert">{{error}}</view>
      <view class="primary-button" hover-class="pressed-scale" bindtap="saveTogether" aria-role="button"><s-icon name="heart" size="14" color="{{buttonInk}}"/><text>Save our story</text></view>
    </view>

    <!-- Preferences -->
    <view wx:elif="{{type === 'preferences'}}" class="settings-form">
      <view class="form-field"><view class="field-label">At your table</view>
        <picker mode="selector" range="{{dietaryOptions}}" value="{{dietaryIndex}}" bindchange="onDietary"><view class="select-input"><text>{{dietaryOptions[dietaryIndex]}}</text><s-icon name="chevron-down" size="14" color="{{ink}}"/></view></picker>
      </view>
      <view class="cuisine-fieldset">
        <view class="field-label cuisine-legend">Cuisines you love</view>
        <view class="cuisine-options">
          <view wx:for="{{cuisines}}" wx:key="name" class="cuisine-option {{item.selected ? 'is-selected' : ''}}" hover-class="pressed" data-name="{{item.name}}" bindtap="toggleCuisine" aria-role="button" aria-label="{{item.name}}">
            <text>{{item.name}}</text><s-icon wx:if="{{item.selected}}" name="check" size="12" color="{{dusk ? '#dae8c7' : '#49553a'}}"/>
          </view>
        </view>
      </view>
      <view class="preference-tip"><s-icon name="sparkles" size="17" color="#818873" stroke="1.2"/><text>Make it your own. Add personal tags like Date Night or Sunday Ritual when you save a memory.</text></view>
      <view class="primary-button" hover-class="pressed-scale" bindtap="savePreferences" aria-role="button"><s-icon name="check" size="15" color="{{buttonInk}}"/><text>Save preferences</text></view>
    </view>

    <!-- Settings -->
    <view wx:elif="{{type === 'settings'}}">
      <view class="field-section-title">Make yourself at home</view>
      <view class="theme-options">
        <view wx:for="{{themes}}" wx:key="value" class="theme-option {{settings.theme === item.value ? 'is-selected' : ''}}" hover-class="pressed" data-value="{{item.value}}" bindtap="setTheme" aria-role="button" aria-label="{{item.label}} theme">
          <view class="theme-preview theme-preview-{{item.value}}"/>
          <view class="theme-option-row"><text>{{item.label}}</text><s-icon wx:if="{{settings.theme === item.value}}" name="check" size="13" color="{{ink}}"/></view>
        </view>
      </view>
      <view class="toggle-row" hover-class="pressed" data-key="reminders" bindtap="toggleSetting" aria-role="switch" aria-checked="{{settings.reminders}}">
        <view class="toggle-copy"><view class="toggle-title">In-app reminders</view><view class="toggle-text">A nudge to notice the little moments.</view></view>
        <view class="toggle-track {{settings.reminders ? 'is-on' : ''}}"><view class="toggle-knob"/></view>
      </view>
      <view class="toggle-row" hover-class="pressed" data-key="reduceMotion" bindtap="toggleSetting" aria-role="switch" aria-checked="{{settings.reduceMotion}}">
        <view class="toggle-copy"><view class="toggle-title">Quiet motion</view><view class="toggle-text">Keep transitions simple and gentle.</view></view>
        <view class="toggle-track {{settings.reduceMotion ? 'is-on' : ''}}"><view class="toggle-knob"/></view>
      </view>
      <view class="app-signature">
        <view class="app-signature-name">Savor</view>
        <view class="app-signature-text">For the meals that become memories.</view>
        <view class="app-signature-small">Version 1.0 / Your personal food diary</view>
      </view>
    </view>

    <!-- Privacy -->
    <view wx:elif="{{type === 'privacy'}}">
      <view class="privacy-intro">
        <s-icon name="lock-keyhole" size="28" color="#81926b" stroke="1"/>
        <view class="privacy-title">Your moments. Your choice.</view>
        <view class="privacy-text">This diary is saved on this device inside WeChat, not on a server. There is no account or cloud sync.</view>
      </view>
      <view class="toggle-row" hover-class="pressed" data-key="privateByDefault" bindtap="toggleSetting" aria-role="switch" aria-checked="{{settings.privateByDefault}}">
        <view class="toggle-copy"><view class="toggle-title">Private by default</view><view class="toggle-text">Keep new memories just for you.</view></view>
        <view class="toggle-track {{settings.privateByDefault ? 'is-on' : ''}}"><view class="toggle-knob"/></view>
      </view>
      <view class="toggle-row" hover-class="pressed" data-key="showLocations" bindtap="toggleSetting" aria-role="switch" aria-checked="{{settings.showLocations}}">
        <view class="toggle-copy"><view class="toggle-title">Location in details</view><view class="toggle-text">Display the city on memory pages.</view></view>
        <view class="toggle-track {{settings.showLocations ? 'is-on' : ''}}"><view class="toggle-knob"/></view>
      </view>
      <view class="helper-note privacy-note">Removing this mini program from WeChat clears the diary. Export a backup to keep your memories safe. Photos you add stay in this mini program's private storage; the map is provided by WeChat.</view>
      <view class="secondary-button full-width" hover-class="pressed" bindtap="openLibrary" aria-role="button"><s-icon name="archive" size="15" color="{{ink}}"/><text>Manage &amp; back up memories</text></view>
      <view class="privacy-links">
        <text class="text-link" bindtap="openPrivacyContract">{{privacyName || 'Privacy guide'}}</text>
        <text class="text-link" bindtap="openSettings">Permissions</text>
      </view>
    </view>

    <!-- Weekly -->
    <view wx:elif="{{type === 'weekly'}}">
      <view class="weekly-sheet-stats">
        <view class="stat weekly-stat"><view class="stat-value">{{stats.weekMeals}}</view><view class="stat-label">Meals remembered</view></view>
        <view class="stat weekly-stat"><view class="stat-value">{{stats.weekPlaces}}</view><view class="stat-label">Places explored</view></view>
      </view>
      <view class="weekly-chart" aria-label="Meal memories across the week">
        <view wx:for="{{bars}}" wx:key="id" class="weekly-bar-col">
          <view class="weekly-bar {{item.highlight ? 'is-highlight' : ''}}" style="height:{{item.height}}%"/>
          <view class="weekly-bar-label">{{item.label}}</view>
        </view>
      </view>
      <view class="weekly-reflection">A good week is made of little moments.</view>
      <view class="weekly-memory-list">
        <memory-row wx:for="{{recent}}" wx:key="id" memory="{{item}}" ink="{{muted}}" bind:select="openMemory"/>
      </view>
      <view class="primary-button" hover-class="pressed-scale" bindtap="goAdd" aria-role="button"><s-icon name="plus" size="17" color="{{buttonInk}}"/><text>Keep another moment</text></view>
    </view>

    <!-- Journey -->
    <view wx:elif="{{type === 'journey'}}">
      <view class="journey-opening">Not just the places.<text class="br"/>The way we felt there.</view>
      <view class="journey-timeline">
        <view wx:for="{{timeline}}" wx:key="index" class="timeline-stop">
          <view class="timeline-dot {{index === 0 ? 'is-first' : ''}}"/>
          <view class="timeline-date">{{item.date}}</view>
          <view class="timeline-title">{{item.title}}</view>
          <view class="timeline-text">{{item.text}}</view>
        </view>
      </view>
      <view class="primary-button" hover-class="pressed-scale" bindtap="goMap" aria-role="button"><s-icon name="map-pin" size="15" color="{{buttonInk}}"/><text>Explore our places</text></view>
    </view>

    <!-- Notifications -->
    <view wx:elif="{{type === 'notifications'}}">
      <view wx:if="{{settings.notificationsRead}}" class="caught-up">
        <s-icon name="check" size="31" color="#82916c" stroke="1"/>
        <view class="caught-up-title">All caught up.</view>
        <view class="caught-up-text">Go make a memory worth keeping.</view>
      </view>
      <block wx:else>
        <view wx:if="{{noteMemory}}" class="notification-row" hover-class="pressed" bindtap="openNoteMemory" aria-role="button">
          <image class="notification-photo" src="{{noteMemory.photo}}" mode="aspectFill"/>
          <view class="notification-copy"><view class="notification-title">A moment with {{profile.partner}}</view><view class="notification-text">Remember that dinner at {{noteMemory.restaurant}}?</view><view class="notification-time">A little while ago</view></view>
          <s-icon name="chevron-right" size="13" color="{{muted}}"/>
        </view>
        <view class="notification-row" hover-class="pressed" bindtap="openWeekly" aria-role="button">
          <view class="notification-symbol"><s-icon name="sparkles" size="21" color="#7c8b67" stroke="1.2"/></view>
          <view class="notification-copy"><view class="notification-title">Your week, beautifully kept</view><view class="notification-text">Take a little look at your latest memories.</view><view class="notification-time">Your weekly reflection</view></view>
          <s-icon name="chevron-right" size="13" color="{{muted}}"/>
        </view>
      </block>
      <view class="primary-button notifications-action" hover-class="pressed-scale" bindtap="markRead" aria-role="button"><s-icon name="bell" size="14" color="{{buttonInk}}"/><text>{{settings.notificationsRead ? 'Back to the good stuff' : 'Mark all as read'}}</text></view>
    </view>

    <!-- Help -->
    <view wx:elif="{{type === 'help'}}">
      <view class="faq-list">
        <view wx:for="{{faqs}}" wx:key="question" class="faq-item">
          <view class="faq-question" hover-class="pressed" data-index="{{index}}" bindtap="toggleFaq" aria-role="button" aria-expanded="{{expanded === index}}">
            <text>{{item.question}}</text><view class="faq-chevron {{expanded === index ? 'is-open' : ''}}"><s-icon name="chevron-down" size="14" color="#909b80"/></view>
          </view>
          <view wx:if="{{expanded === index}}" class="faq-answer">{{item.answer}}</view>
        </view>
      </view>
      <view class="feedback-form">
        <view class="form-field"><view class="field-label">A thought to make Savor better?</view><textarea class="field-textarea feedback-textarea" value="{{message}}" bindinput="onMessage" placeholder="We would love to hear it..." placeholder-class="placeholder" maxlength="1000"/></view>
        <view class="primary-button feedback-action" hover-class="pressed-scale" bindtap="sendFeedback" aria-role="button"><s-icon name="send" size="14" color="{{buttonInk}}"/><text>Save feedback note</text></view>
      </view>
      <view class="helper-note help-note">Feedback is kept locally in this concept, not sent to a server.{{feedbackNote}}</view>
    </view>
  </view>
</view>
