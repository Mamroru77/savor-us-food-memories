.add-body { padding: 0 47rpx 37rpx; }
.photo-editor-row { height: 430rpx; display: flex; align-items: center; gap: 20rpx; margin: 40rpx 0 37rpx; }
.main-photo-wrap { width: 445rpx; height: 430rpx; flex: 0 0 445rpx; position: relative; border-radius: 42rpx; overflow: hidden; background: rgba(255, 255, 255, 0.12); }
.main-memory-photo { width: 100%; height: 100%; display: block; }
.photo-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30rpx; width: 100%; height: 100%; box-sizing: border-box; border: 1rpx dashed rgba(255, 255, 255, 0.9); border-radius: 42rpx; color: var(--muted); font-size: 25rpx; background: rgba(255, 255, 255, 0.17); }
.theme-dusk .photo-placeholder { border-color: rgba(225, 229, 214, 0.35); background: rgba(225, 229, 214, 0.06); }
.edit-photo { position: absolute; right: 22rpx; top: 22rpx; height: 60rpx; min-width: 112rpx; padding: 0 20rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 10rpx; font-size: 23rpx; border-radius: 37rpx; border: 1rpx solid rgba(255, 255, 255, 0.72); background: rgba(249, 248, 245, 0.8); color: #33332f; box-shadow: 0 5rpx 17rpx rgba(44, 41, 36, 0.1); }
.photo-uploading { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; background: rgba(247, 245, 240, 0.65); }
.more-photos-wrap { position: relative; }
.add-photo { height: 320rpx; width: 175rpx; border: 3rpx dashed rgba(255, 255, 255, 0.93); border-radius: 40rpx; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; background: rgba(255, 255, 255, 0.12); box-sizing: border-box; }
.theme-dusk .add-photo { border-color: rgba(225, 229, 214, 0.35); background: rgba(225, 229, 214, 0.06); }
.add-photo-preview { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0.6; }
.add-photo-copy { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 17rpx; align-items: center; font-size: 24rpx; color: var(--muted); }
.add-photo.has-photo .add-photo-copy { color: #ffffff; text-shadow: 0 1rpx 8rpx #555555; }
.remove-extra { position: absolute; width: 50rpx; height: 50rpx; top: -15rpx; right: -12rpx; border-radius: 50%; background: #f4f2ed; z-index: 2; display: flex; align-items: center; justify-content: center; box-shadow: 0 5rpx 12rpx rgba(0, 0, 0, 0.13); }

.input-wrap { position: relative; }
.input-wrap .field-input { padding-right: 72rpx; }
.input-clear { position: absolute; top: 9rpx; right: 10rpx; }
.place-suggestions { margin-top: 10rpx; border-radius: 24rpx; padding: 6rpx 22rpx; background: rgba(248, 247, 243, 0.96); }
.theme-dusk .place-suggestions { background: rgba(70, 82, 63, 0.97); }
.place-suggestion { padding: 20rpx 0; font-size: 26rpx; border-bottom: 1rpx solid var(--line); }
.place-suggestion:last-child { border-bottom: 0; }
.new-place-location { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }
.city-select { display: inline-flex; align-items: center; gap: 8rpx; height: 58rpx; padding: 0 14rpx; font-size: 22rpx; border: 1rpx solid var(--field-border); background: var(--field); border-radius: 15rpx; color: var(--ink); }
.notes-field { margin-top: 25rpx; }
.date-rating-row { display: flex; gap: 32rpx; margin-top: 25rpx; }
.date-rating-row .form-field { flex: 1; }
.date-input { font-size: 26rpx; white-space: nowrap; }
.rating-input { display: flex; align-items: center; justify-content: space-between; height: 83rpx; padding: 0 15rpx; box-sizing: border-box; border: 1rpx solid var(--field-border); border-radius: 28rpx; background: var(--field); }
.rating-star { width: 50rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; }
.tags-field { margin-top: 25rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; min-height: 60rpx; }
.add-tag { width: 60rpx; height: 60rpx; background: rgba(212, 212, 208, 0.5); margin-left: 2rpx; }
.theme-dusk .add-tag { background: rgba(161, 175, 140, 0.25); }
.tag-popover { margin-top: 20rpx; padding: 25rpx; border-radius: 32rpx; background: rgba(248, 247, 243, 0.97); }
.theme-dusk .tag-popover { background: rgba(70, 82, 63, 0.97); }
.tag-input-row { display: flex; align-items: center; gap: 12rpx; }
.tag-input { flex: 1; height: 72rpx; min-height: 72rpx; }
.suggested-tags { display: flex; gap: 20rpx; flex-wrap: wrap; margin-top: 22rpx; }
.suggested-tag { font-size: 25rpx; color: #62665b; text-decoration: underline; text-underline-offset: 6rpx; padding: 6rpx 0; }
.theme-dusk .suggested-tag { color: #bac7ab; }
.save-memory { height: 100rpx; margin-top: 37rpx; }
