.me-body { padding: 20rpx 35rpx 45rpx; }
.profile-heading { display: flex; align-items: center; gap: 35rpx; height: 185rpx; margin: 0 5rpx 57rpx; }
.profile-avatar { width: 180rpx; height: 180rpx; flex-shrink: 0; border-width: 4rpx; }
.profile-copy { min-width: 0; flex: 1; }
.profile-name { font-family: var(--serif); font-size: 60rpx; line-height: 72rpx; letter-spacing: -0.8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.profile-bio { font-size: 27rpx; line-height: 37rpx; margin-top: 10rpx; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.edit-profile-button { width: 77rpx; height: 77rpx; background: rgba(255, 255, 255, 0.2); margin-right: -5rpx; }
.theme-dusk .edit-profile-button { background: rgba(225, 229, 214, 0.1); }
.profile-stats-card { position: relative; height: 337rpx; border-radius: 42rpx; background: rgba(255, 255, 255, 0.36); }
.theme-dusk .profile-stats-card { background: var(--glass); }
.profile-stats { position: absolute; top: 57rpx; left: 22rpx; right: 22rpx; display: flex; }
.profile-stats .stat { flex: 1; font-size: 25rpx; line-height: 37rpx; }
.profile-stats .stat-value { font-size: 65rpx; line-height: 72rpx; }
.profile-stats .stat-divider { border-color: rgba(111, 115, 112, 0.045); }
.theme-dusk .profile-stats .stat-divider { border-color: var(--line); }
.memory-chart { position: absolute; bottom: 30rpx; left: 37rpx; right: 37rpx; width: calc(100% - 74rpx); height: 122rpx; }
.profile-menu { margin-top: 35rpx; padding: 5rpx 27rpx; border-radius: 42rpx; background: rgba(255, 255, 255, 0.37); }
.theme-dusk .profile-menu { background: var(--glass); }
.profile-menu-row { display: flex; align-items: center; gap: 25rpx; height: 130rpx; border-bottom: 1rpx solid rgba(72, 76, 70, 0.055); }
.theme-dusk .profile-menu-row { border-color: var(--line); }
.profile-menu-row:last-child { border-bottom: 0; }
.profile-menu-copy { display: flex; flex-direction: column; min-width: 0; flex: 1; gap: 5rpx; }
.profile-menu-title { font-size: 29rpx; line-height: 37rpx; font-weight: 500; letter-spacing: -0.3rpx; }
.profile-menu-subtitle { font-size: 24rpx; line-height: 33rpx; color: var(--muted); letter-spacing: -0.3rpx; }
