<view class="page {{dusk ? 'theme-dusk' : ''}} {{quiet ? 'quiet' : ''}}">
  <page-header title="Us" subtitle="Our space. Our memories." ink="{{ink}}">
    <view class="icon-button" hover-class="pressed" bindtap="openTogether" aria-role="button" aria-label="Shared space settings">
      <s-icon name="settings" size="17" color="{{ink}}" stroke="1.35"/>
    </view>
  </page-header>
  <view class="us-body">
    <view class="together-card glass">
      <view class="couple-avatars">
        <image class="avatar couple-avatar" src="{{profile.avatar}}" mode="aspectFill" aria-label="{{profile.name}}"/>
        <view class="couple-heart {{loveSent ? 'love-sent' : ''}}" hover-class="pressed-scale" bindtap="toggleLove" aria-role="button" aria-label="{{loveSent ? 'Remove your little love' : 'Add a little love'}}">
          <s-icon name="heart" size="19" color="{{loveSent ? '#e55d48' : '#f38d77'}}" fill="current" stroke="1.4"/>
        </view>
        <image class="avatar couple-avatar" src="{{alexPhoto}}" mode="aspectFill" aria-label="{{profile.partner}}"/>
      </view>
      <view class="together-count" hover-class="pressed" bindtap="openTogether" aria-role="button" aria-label="Together for {{stats.days}} days">
        <view class="together-label">Together for</view>
        <view class="together-days"><text class="together-number">{{stats.days}}</text><text class="together-unit">days</text></view>
      </view>
    </view>

    <view class="journey-card glass" hover-class="pressed" bindtap="openJourney" aria-role="button" aria-label="Our journey">
      <view class="journey-title">Our Journey</view>
      <view class="journey-stats">
        <view class="stat"><view class="stat-value">{{stats.journeyMeals}}</view><view class="stat-label">Meals</view></view>
        <view class="stat stat-divider"><view class="stat-value">{{stats.journeyPlaces}}</view><view class="stat-label">Places</view></view>
        <view class="stat stat-divider"><view class="stat-value">{{stats.journeyCountries}}</view><view class="stat-label">Countries</view></view>
      </view>
      <view class="journey-latest">
        <text class="journey-latest-text">Latest: {{stats.latest}}</text>
        <image class="journey-latest-photo" src="{{parisPhoto}}" mode="aspectFill" aria-label="Our latest journey"/>
      </view>
    </view>

    <view class="section-heading">
      <view class="section-heading-title">Shared Moments</view>
      <view class="see-all" hover-class="pressed" bindtap="openLibrary" aria-role="button">See all</view>
    </view>
    <scroll-view wx:if="{{shared.length}}" scroll-x class="shared-gallery" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="shared-track">
        <view wx:for="{{shared}}" wx:key="id" class="shared-photo-card">
          <view class="shared-photo-open" hover-class="pressed" data-id="{{item.id}}" bindtap="openMemory" aria-role="button" aria-label="Open shared memory at {{item.restaurant}}">
            <image class="shared-photo" src="{{item.cover}}" mode="aspectFill"/>
            <view class="shared-photo-shade"/>
            <view class="shared-photo-copy">
              <view class="shared-photo-name">{{item.restaurant}}</view>
              <view class="shared-photo-date">{{item.dateLabel}}</view>
            </view>
          </view>
          <view class="shared-like" hover-class="pressed-scale" data-id="{{item.id}}" catchtap="toggleLike" aria-role="button" aria-label="{{item.liked ? 'Unlike' : 'Like'}} {{item.restaurant}}">
            <s-icon name="heart" size="14" color="{{item.liked ? '#e1e1dc' : '#ffffff'}}" fill="{{item.liked ? 'current' : 'none'}}" stroke="1.3"/>
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="empty-state">Good food is even better together.<text class="br"/>Share a memory to start your story.</view>
    <view class="tab-spacer"/>
  </view>
</view>
